# .gitignore
# Python unittest temporary files
__pycache__/
*.pyc
*.pyo
*.pyd
*.cache
*.log

# Temporary files
*.tmp
*.temp
*.swp

# Jupyter Notebook
.ipynb_checkpoints/

# Other Python files and directories to ignore
*.egg-info/
dist/
build/
.coverage
.venv/

# Secrets
.env
*.env
# ...except these two committed pipeline parameter configs, which hold no
# credentials (they are reproducibility knobs; endpoints come from the env).
!experiments/tts_voice_analysis/pipeline/pipeline_config.env
!experiments/tts_voice_analysis/pipeline/pipeline_config.test.env

# Local agent/editor settings
.claude/settings.local.json

# Data — generated corpora, not the docs page's own data
data/
!docs/data/

tags

output/
.codex
.vscode/
# Internal GitLab CI - references internal registry/hosts, not for the public repo
.gitlab-ci.yml
