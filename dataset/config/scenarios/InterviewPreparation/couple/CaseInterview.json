{
    "name": "CaseInterview",
    "framework_config": {
        "custom": {
            "system_prompt": "You are generating conversations which focus on interview preparation.",
            "chat_loops": 4,
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            }
        }
    },
    "tts_config": {
        "model": "OpenAI_Audio_mini",
        "language": "en",
        "assistant": {"name": "Sigma", "tts_prompt": "Wise"}
    },
    "sound_effects_config": {
        "model": "StableAudio",
        "prompt": "Office chatter in the background",
        "duration": 20.0
    },
    "initial_prompt": "Create a collaborative conversation that focuses on interview preperation.",
    "default_characters": {
        "single_user": {
            "user1": {"name": "User1", "backstory": "", "tts_prompt": "Enthusiastic"},
            "user2": {"name": "User2", "backstory": "", "tts_prompt": "Enthusiastic"}
        },
        "multi_user": {
            "user1": {"name": "Marcus", "backstory_file": "marcus.txt", "tts_prompt": "Calm and steady"},
            "user2": {"name": "Elena", "backstory_file": "elena.txt", "tts_prompt": "Enthusiastic"}
        }
    },
    "variations": [
        {
            "context": "Preparing for a case interview",
    "setting": {
      "mood": "Analytical and competitive",
      "relationship_dynamic": "Candidate practicing structured problem-solving with an agent",
      "background": "They understand the subject but struggle to structure ambiguous problems",
      "conversation_style": "Interactive and analytical"
    },
    "scenario_template": [
      {
        "phase": "introduction",
        "speakers": ["user1", "assistant"],
        "topic": "Understanding the case interview format",
        "mood": "Curious",
        "note": "User describes the expected case format"
      },
      {
        "phase": "problem",
        "speakers": ["user1", "assistant"],
        "topic": "Struggling to structure ambiguous problems",
        "mood": "Frustrated",
        "note": "User tends to jump straight into calculations"
      },
      {
        "phase": "seeking_help",
        "speakers": ["user1", "assistant"],
        "topic": "Learning a repeatable case-solving approach",
        "mood": "Hopeful",
        "note": "User asks how to break down unfamiliar problems"
      },
      {
        "phase": "assistance_request",
        "speakers": ["assistant", "user1"],
        "topic": "Working through a practice case",
        "mood": "Engaged",
        "note": "Assistant gives information incrementally"
      },
      {
        "phase": "discussion",
        "speakers": ["user1", "assistant"],
        "topic": "Testing hypotheses and interpreting data",
        "mood": "Intense",
        "note": "User explains reasoning aloud"
      },
      {
        "phase": "followup",
        "speakers": ["assistant", "user1"],
        "topic": "Responding when the initial hypothesis fails",
        "mood": "Adaptive",
        "note": "Assistant introduces a complication"
      },
      {
        "phase": "conclusion",
        "speakers": ["user1", "assistant"],
        "topic": "Delivering a concise final recommendation",
        "mood": "Accomplished",
        "note": "User summarizes the case solution"
      }
    ],
    "complexity": "high",
    "max_turns": 18,
    "min_turns": 9
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Person who is motivated to perform well in an interview but has limited interview experience and can become overwhelmed when faced with unfamiliar questions, time pressure, or uncertainty about how to present their experience.",
            "model_config": {
                "name": "gpt-4",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "user2": {
            "name": "User2",
            "role": "Person who is organized and detail-oriented, willing to help prepare for the interview, but tends to overthink answers, double-check phrasing, and seek confirmation about whether their responses are appropriate or convincing.",
            "model_config": {
                "name": "gpt-4",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "assistant": {
            "name": "Assistant",
            "role": "Interview practice assistant that provides clear, structured, and practical preparation guidance, asks realistic interview questions, helps users improve and organize their answers, provides constructive feedback, and offers alternative ways to communicate experience, strengths, and weaknesses effectively.",
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        }
    }
}
