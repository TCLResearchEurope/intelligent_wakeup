{
    "name": "BehavioralInterview",
    "framework_config": {
        "custom": {
            "system_prompt": "You are generating conversations which focus on interview preparation.",
            "chat_loops": 4,
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            }
        }
    },
    "tts_config": {
        "model": "ElevenLabs",
        "language": "en",
        "assistant": {
            "name": "Sigma",
            "tts_prompt": "Wise"
        }
    },
    "sound_effects_config": {
        "model": "ElevenLabs",
        "prompt": "Office chatter in the background",
        "duration": 20.0
    },
    "initial_prompt": "Create a collaborative conversation that focuses on interview preperation.",
    "default_characters": {
        "single_user": {
            "user1": {
                "name": "User1",
                "backstory": "",
                "tts_prompt": "Enthusiastic"
            },
            "user2": {
                "name": "User2",
                "backstory": "",
                "tts_prompt": "Enthusiastic"
            }
        },
        "multi_user": {
            "user1": {
                "name": "Callum",
                "backstory_file": "callum.txt",
                "tts_prompt": "Calm and steady"
            },
            "user2": {
                "name": "Renee",
                "backstory_file": "renee.txt",
                "tts_prompt": "Enthusiastic"
            }
        }
    },
    "variations": [
        {
            "context": "Practicing answers to behavioral interview questions",
            "setting": {
                "mood": "Focused and slightly nervous",
                "relationship_dynamic": "Candidate using the agent as a practice partner",
                "background": "They struggle to turn real experiences into concise interview answers",
                "conversation_style": "Interactive and coaching-oriented"
            },
            "scenario_template": [
                {
                    "phase": "introduction",
                    "speakers": [
                        "user1",
                        "assistant"
                    ],
                    "topic": "Starting a behavioral interview practice session",
                    "mood": "Determined",
                    "note": "User asks to practice common behavioral questions"
                },
                {
                    "phase": "problem",
                    "speakers": [
                        "user1",
                        "assistant"
                    ],
                    "topic": "Giving overly long and unfocused answers",
                    "mood": "Frustrated",
                    "note": "User describes difficulty staying concise"
                },
                {
                    "phase": "seeking_help",
                    "speakers": [
                        "user1",
                        "assistant"
                    ],
                    "topic": "Learning a structure for behavioral responses",
                    "mood": "Curious",
                    "note": "User asks how to organize their stories"
                },
                {
                    "phase": "assistance_request",
                    "speakers": [
                        "assistant",
                        "user1"
                    ],
                    "topic": "Practicing a structured response",
                    "mood": "Encouraged",
                    "note": "Assistant asks questions and helps reshape an answer"
                },
                {
                    "phase": "discussion",
                    "speakers": [
                        "user1",
                        "assistant"
                    ],
                    "topic": "Improving specificity and impact",
                    "mood": "Analytical",
                    "note": "They identify missing context, actions, and outcomes"
                },
                {
                    "phase": "followup",
                    "speakers": [
                        "assistant",
                        "user1"
                    ],
                    "topic": "Handling follow-up questions",
                    "mood": "Challenging but constructive",
                    "note": "Assistant probes the user's example like an interviewer"
                },
                {
                    "phase": "conclusion",
                    "speakers": [
                        "user1",
                        "assistant"
                    ],
                    "topic": "Reflecting on improvements",
                    "mood": "Confident",
                    "note": "User recognizes how to make future answers stronger"
                }
            ],
            "complexity": "moderate",
            "max_turns": 14,
            "min_turns": 8
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Person who is motivated to perform well in an interview but has limited interview experience and can become overwhelmed when faced with unfamiliar questions, time pressure, or uncertainty about how to present their experience.",
            "model_config": {
                "name": "gpt-4",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "user2": {
            "name": "User2",
            "role": "Person who is organized and detail-oriented, willing to help prepare for the interview, but tends to overthink answers, double-check phrasing, and seek confirmation about whether their responses are appropriate or convincing.",
            "model_config": {
                "name": "gpt-4",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "assistant": {
            "name": "Assistant",
            "role": "Interview practice assistant that provides clear, structured, and practical preparation guidance, asks realistic interview questions, helps users improve and organize their answers, provides constructive feedback, and offers alternative ways to communicate experience, strengths, and weaknesses effectively.",
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        }
    }
}
