{
    "name": "SecondRound",
    "framework_config": {
        "custom": {
            "system_prompt": "You are generating conversations which focus on interview preparation.",
            "chat_loops": 4,
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            }
        }
    },
    "tts_config": {
        "model": "ElevenLabs",
        "language": "en",
        "assistant": {
            "name": "Sigma",
            "tts_prompt": "Wise"
        }
    },
    "sound_effects_config": {
        "model": "ElevenLabs",
        "prompt": "Office chatter in the background",
        "duration": 20.0
    },
    "initial_prompt": "Create a collaborative conversation that focuses on interview preperation.",
    "default_characters": {
        "single_user": {
            "user1": {
                "name": "User1",
                "backstory": "",
                "tts_prompt": "Enthusiastic"
            },
            "user2": {
                "name": "User2",
                "backstory": "",
                "tts_prompt": "Enthusiastic"
            }
        },
        "multi_user": {
            "user1": {
                "name": "Griff",
                "backstory_file": "griff.txt",
                "tts_prompt": "Calm and steady"
            },
            "user2": {
                "name": "Layla",
                "backstory_file": "layla.txt",
                "tts_prompt": "Enthusiastic"
            }
        }
    },
    "variations": [
        {
            "context": "Preparing for a second-round interview",
            "setting": {
                "mood": "Optimistic but pressured",
                "relationship_dynamic": "Candidate who advanced in the process seeking deeper preparation",
                "background": "The first interview went well but the next stage appears more demanding",
                "conversation_style": "Strategic and reflective"
            },
            "scenario_template": [
                {
                    "phase": "introduction",
                    "speakers": [
                        "user1",
                        "assistant"
                    ],
                    "topic": "Reviewing what changed between interview rounds",
                    "mood": "Optimistic",
                    "note": "User shares what happened in the first round"
                },
                {
                    "phase": "problem",
                    "speakers": [
                        "user1",
                        "assistant"
                    ],
                    "topic": "Not knowing what the second round will test",
                    "mood": "Uncertain",
                    "note": "User wants to avoid repeating the same preparation"
                },
                {
                    "phase": "seeking_help",
                    "speakers": [
                        "user1",
                        "assistant"
                    ],
                    "topic": "Inferring likely second-round priorities",
                    "mood": "Curious",
                    "note": "They examine the role and previous interview"
                },
                {
                    "phase": "assistance_request",
                    "speakers": [
                        "assistant",
                        "user1"
                    ],
                    "topic": "Creating a deeper practice plan",
                    "mood": "Focused",
                    "note": "Assistant emphasizes examples, depth, and follow-ups"
                },
                {
                    "phase": "discussion",
                    "speakers": [
                        "user1",
                        "assistant"
                    ],
                    "topic": "Revisiting weak moments from the first interview",
                    "mood": "Reflective",
                    "note": "User identifies answers they would improve"
                },
                {
                    "phase": "followup",
                    "speakers": [
                        "assistant",
                        "user1"
                    ],
                    "topic": "Practicing deeper probing",
                    "mood": "Challenging",
                    "note": "Assistant asks increasingly specific follow-ups"
                },
                {
                    "phase": "conclusion",
                    "speakers": [
                        "user1",
                        "assistant"
                    ],
                    "topic": "Turning first-round lessons into an advantage",
                    "mood": "Confident",
                    "note": "User has a more targeted strategy"
                }
            ],
            "complexity": "high",
            "max_turns": 14,
            "min_turns": 8,
            "variant_name": "SecondRound"
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Person who is motivated to perform well in an interview but has limited interview experience and can become overwhelmed when faced with unfamiliar questions, time pressure, or uncertainty about how to present their experience.",
            "model_config": {
                "name": "gpt-4",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "user2": {
            "name": "User2",
            "role": "Person who is organized and detail-oriented, willing to help prepare for the interview, but tends to overthink answers, double-check phrasing, and seek confirmation about whether their responses are appropriate or convincing.",
            "model_config": {
                "name": "gpt-4",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "assistant": {
            "name": "Assistant",
            "role": "Interview practice assistant that provides clear, structured, and practical preparation guidance, asks realistic interview questions, helps users improve and organize their answers, provides constructive feedback, and offers alternative ways to communicate experience, strengths, and weaknesses effectively.",
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        }
    }
}
