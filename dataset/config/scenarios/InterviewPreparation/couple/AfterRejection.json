{
    "name": "AfterRejection",
    "framework_config": {
        "custom": {
            "system_prompt": "You are generating conversations which focus on interview preparation.",
            "chat_loops": 4,
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            }
        }
    },
    "tts_config": {
        "model": "ElevenLabs",
        "language": "en",
        "assistant": {
            "name": "Sigma",
            "tts_prompt": "Wise"
        }
    },
    "sound_effects_config": {
        "model": "ElevenLabs",
        "prompt": "Office chatter in the background",
        "duration": 20.0
    },
    "initial_prompt": "Create a collaborative conversation that focuses on interview preperation.",
    "default_characters": {
        "single_user": {
            "user1": {
                "name": "User1",
                "backstory": "",
                "tts_prompt": "Enthusiastic"
            },
            "user2": {
                "name": "User2",
                "backstory": "",
                "tts_prompt": "Enthusiastic"
            }
        },
        "multi_user": {
            "user1": {
                "name": "Marcus",
                "backstory_file": "marcus.txt",
                "tts_prompt": "Calm and steady"
            },
            "user2": {
                "name": "Tessa",
                "backstory_file": "tessa.txt",
                "tts_prompt": "Enthusiastic"
            }
        }
    },
    "variations": [
        {
            "context": "Practicing an interview after receiving a rejection",
            "setting": {
                "mood": "Reflective and disappointed",
                "relationship_dynamic": "Job seeker using the agent to learn from a previous interview",
                "background": "User reached a late stage but was rejected and wants to improve",
                "conversation_style": "Honest and diagnostic"
            },
            "scenario_template": [
                {
                    "phase": "introduction",
                    "speakers": [
                        "user1",
                        "assistant"
                    ],
                    "topic": "Reviewing the previous interview",
                    "mood": "Reflective",
                    "note": "User describes how the interview went"
                },
                {
                    "phase": "problem",
                    "speakers": [
                        "user1",
                        "assistant"
                    ],
                    "topic": "Not knowing why they were rejected",
                    "mood": "Disappointed",
                    "note": "User received little or no useful feedback"
                },
                {
                    "phase": "seeking_help",
                    "speakers": [
                        "user1",
                        "assistant"
                    ],
                    "topic": "Identifying possible weaknesses",
                    "mood": "Determined",
                    "note": "User wants actionable rather than generic feedback"
                },
                {
                    "phase": "assistance_request",
                    "speakers": [
                        "assistant",
                        "user1"
                    ],
                    "topic": "Reconstructing difficult interview moments",
                    "mood": "Analytical",
                    "note": "Assistant asks the user to reproduce questions and answers"
                },
                {
                    "phase": "discussion",
                    "speakers": [
                        "user1",
                        "assistant"
                    ],
                    "topic": "Examining clarity, relevance, and confidence",
                    "mood": "Honest",
                    "note": "They identify patterns across answers"
                },
                {
                    "phase": "followup",
                    "speakers": [
                        "assistant",
                        "user1"
                    ],
                    "topic": "Re-answering the weakest questions",
                    "mood": "Constructive",
                    "note": "User practices improved versions"
                },
                {
                    "phase": "conclusion",
                    "speakers": [
                        "user1",
                        "assistant"
                    ],
                    "topic": "Turning rejection into a preparation plan",
                    "mood": "Resilient",
                    "note": "User leaves with specific improvements"
                }
            ],
            "complexity": "high",
            "max_turns": 14,
            "min_turns": 8,
            "variant_name": "AfterRejection"
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Person who is motivated to perform well in an interview but has limited interview experience and can become overwhelmed when faced with unfamiliar questions, time pressure, or uncertainty about how to present their experience.",
            "model_config": {
                "name": "gpt-4",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "user2": {
            "name": "User2",
            "role": "Person who is organized and detail-oriented, willing to help prepare for the interview, but tends to overthink answers, double-check phrasing, and seek confirmation about whether their responses are appropriate or convincing.",
            "model_config": {
                "name": "gpt-4",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "assistant": {
            "name": "Assistant",
            "role": "Interview practice assistant that provides clear, structured, and practical preparation guidance, asks realistic interview questions, helps users improve and organize their answers, provides constructive feedback, and offers alternative ways to communicate experience, strengths, and weaknesses effectively.",
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        }
    }
}
