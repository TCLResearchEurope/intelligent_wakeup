{
    "name": "PanelInterview",
    "framework_config": {
        "custom": {
            "system_prompt": "You are generating conversations which focus on interview preparation.",
            "chat_loops": 4,
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            }
        }
    },
    "tts_config": {
        "model": "ElevenLabs",
        "language": "en",
        "assistant": {
            "name": "Sigma",
            "tts_prompt": "Wise"
        }
    },
    "sound_effects_config": {
        "model": "ElevenLabs",
        "prompt": "Office chatter in the background",
        "duration": 20.0
    },
    "initial_prompt": "Create a collaborative conversation that focuses on interview preperation.",
    "default_characters": {
        "single_user": {
            "user1": {
                "name": "User1",
                "backstory": "",
                "tts_prompt": "Enthusiastic"
            },
            "user2": {
                "name": "User2",
                "backstory": "",
                "tts_prompt": "Enthusiastic"
            }
        },
        "multi_user": {
            "user1": {
                "name": "Marcus",
                "backstory_file": "marcus.txt",
                "tts_prompt": "Calm and steady"
            },
            "user2": {
                "name": "Grace",
                "backstory_file": "grace.txt",
                "tts_prompt": "Enthusiastic"
            }
        }
    },
    "variations": [
        {
            "context": "Preparing for a panel interview",
            "setting": {
                "mood": "Alert and strategic",
                "relationship_dynamic": "Candidate seeking help understanding multiple interviewers",
                "background": "They have mostly experienced one-on-one interviews",
                "conversation_style": "Strategic and interactive"
            },
            "scenario_template": [
                {
                    "phase": "introduction",
                    "speakers": [
                        "user1",
                        "assistant"
                    ],
                    "topic": "Understanding the panel interview format",
                    "mood": "Curious",
                    "note": "User describes the expected panel"
                },
                {
                    "phase": "problem",
                    "speakers": [
                        "user1",
                        "assistant"
                    ],
                    "topic": "Not knowing where to direct attention",
                    "mood": "Uncertain",
                    "note": "User worries about engaging several interviewers"
                },
                {
                    "phase": "seeking_help",
                    "speakers": [
                        "user1",
                        "assistant"
                    ],
                    "topic": "Learning panel interview etiquette",
                    "mood": "Focused",
                    "note": "User asks how to handle multiple perspectives"
                },
                {
                    "phase": "assistance_request",
                    "speakers": [
                        "assistant",
                        "user1"
                    ],
                    "topic": "Simulating questions from different panel members",
                    "mood": "Challenging",
                    "note": "Assistant switches interviewer perspectives"
                },
                {
                    "phase": "discussion",
                    "speakers": [
                        "user1",
                        "assistant"
                    ],
                    "topic": "Balancing concise answers with broad engagement",
                    "mood": "Analytical",
                    "note": "They refine eye contact and answer structure"
                },
                {
                    "phase": "followup",
                    "speakers": [
                        "assistant",
                        "user1"
                    ],
                    "topic": "Handling conflicting or rapid-fire questions",
                    "mood": "Intense",
                    "note": "User practices staying composed"
                },
                {
                    "phase": "conclusion",
                    "speakers": [
                        "user1",
                        "assistant"
                    ],
                    "topic": "Summarizing the panel strategy",
                    "mood": "Prepared",
                    "note": "User understands how to engage the room"
                }
            ],
            "complexity": "high",
            "max_turns": 14,
            "min_turns": 8
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Person who is motivated to perform well in an interview but has limited interview experience and can become overwhelmed when faced with unfamiliar questions, time pressure, or uncertainty about how to present their experience.",
            "model_config": {
                "name": "gpt-4",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "user2": {
            "name": "User2",
            "role": "Person who is organized and detail-oriented, willing to help prepare for the interview, but tends to overthink answers, double-check phrasing, and seek confirmation about whether their responses are appropriate or convincing.",
            "model_config": {
                "name": "gpt-4",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "assistant": {
            "name": "Assistant",
            "role": "Interview practice assistant that provides clear, structured, and practical preparation guidance, asks realistic interview questions, helps users improve and organize their answers, provides constructive feedback, and offers alternative ways to communicate experience, strengths, and weaknesses effectively.",
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        }
    }
}
