{
    "name": "HomeTasks",
    "framework_config": {
        "custom": {
            "system_prompt": "You are generating cooking assistance conversations.",
            "chat_loops": 4,
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            }
        }
    },
    "tts_config": {
        "model": "ElevenLabs",
        "language": "en",
        "assistant": {"name": "Sigma", "tts_prompt": "Energetic"}
    },
    "sound_effects_config": {
        "model": "ElevenLabs",
        "prompt": "Cooking in the kitchen",
        "duration": 20.0
    },
    "initial_prompt": "Create a cooking conversation with alternating turns where a user is preparing a meal with assistant help.",
    "default_characters": {
        "single_user": {
            "user1": {"name": "User1", "backstory": "", "tts_prompt": "Enthusiastic"}
        },
        "multi_user": {
            "user1": {"name": "Marcus", "backstory_file": "marcus.txt", "tts_prompt": "Calm and steady"},
            "user2": {"name": "Elena", "backstory_file": "elena.txt", "tts_prompt": "Enthusiastic"}
        }
    },
    "variations": [
        {
            "context": "Basic recipe help",
            "setting": {
                "mood": "Casual weeknight dinner preparation",
                "relationship_dynamic": "Individual trying to cook with limited experience",
                "background": "They often rely on their smart home assistant for recipes and cooking guidance",
                "conversation_style": "Relaxed but sometimes rushed, with occasional frustration about cooking challenges"
            },
            "scenario_template": [
                {
                    "phase": "introduction",
                    "speakers": ["user1"],
                    "topic": "Deciding what to cook",
                    "mood": "Enthusiastic but uncertain",
                    "note": "Focus on choosing a recipe that matches their skill level with assistant"
                },
                {
                    "phase": "problem",
                    "speakers": ["user1"],
                    "topic": "Discovering a cooking challenge",
                    "mood": "Slight concern about ingredients or techniques",
                    "note": "User realizes they need help with recipe specifics"
                },
                {
                    "phase": "seeking_help",
                    "speakers": ["user1", "assistant"],
                    "topic": "Asking for guidance",
                    "mood": "Hopeful for quick solutions",
                    "note": "User explicitly addresses assistant as Sigma on first interaction"
                },
                {
                    "phase": "assistance_request",
                    "speakers": ["assistant", "user1"],
                    "topic": "Getting cooking instructions",
                    "mood": "Relieved to receive clear guidance",
                    "note": "Assistant provides step-by-step advice tailored to their skill level"
                },
                {
                    "phase": "discussion",
                    "speakers": ["user1", "assistant"],
                    "topic": "Working through the recipe together",
                    "mood": "Collaborative problem-solving",
                    "note": "User discusses the recipe while following assistant's guidance"
                },
                {
                    "phase": "followup",
                    "speakers": ["user1", "assistant"],
                    "topic": "Asking additional questions",
                    "mood": "Curious about variations or techniques",
                    "note": "Assistant offers additional tips for improvement"
                },
                {
                    "phase": "conclusion",
                    "speakers": ["user1"],
                    "topic": "Finishing the recipe",
                    "mood": "Satisfied with the results",
                    "note": "User expresses appreciation for the help and discusses the outcome"
                }
            ],
            "complexity": "moderate",
            "max_turns": 14,
            "min_turns": 7
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Person with basic cooking skills who's eager to learn but gets easily overwhelmed by complex recipes",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "assistant": {
            "name": "Assistant",
            "role": "Cooking assistant providing clear, concise guidance with a focus on simplifying complex techniques and suggesting alternatives for missing ingredients",
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.6
            },
            "history_enabled": true,
            "max_turns": 10
        }
    }
}
