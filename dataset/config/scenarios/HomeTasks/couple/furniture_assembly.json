{
    "name": "FurnitureAssembly",
    "framework_config": {
        "custom": {
            "system_prompt": "You are generating home tasks conversations.",
            "chat_loops": 4,
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            }
        }
    },
    "tts_config": {
        "model": "OpenAI_Audio_mini",
        "language": "en",
        "assistant": {"name": "Sigma", "tts_prompt": "Energetic"}
    },
    "sound_effects_config": {
        "model": "StableAudio",
        "prompt": "Radio in the background",
        "duration": 20.0
    },
    "initial_prompt": "Create a collaborative home task conversation with alternating turns where users work together to complete a household activity and consult the assistant for guidance when needed.",
    "default_characters": {
        "single_user": {
            "user1": {"name": "User1", "backstory": "", "tts_prompt": "Enthusiastic"},
            "user2": {"name": "User2", "backstory": "", "tts_prompt": "Enthusiastic"}
        },
        "multi_user": {
            "user1": {"name": "Oliver", "backstory_file": "oliver.txt", "tts_prompt": "Calm and steady"},
            "user2": {"name": "Elena", "backstory_file": "elena.txt", "tts_prompt": "Enthusiastic"}
        }
    },
    "variations": [
            {
                "context": "Furniture assembly",
                "setting": {
                    "mood": "Determined but cautious",
                    "relationship_dynamic": "Partners building something together",
                    "background": "They have minimal DIY experience",
                    "conversation_style": "Problem-solving with occasional playful blame"
                },
                "scenario_template": [
                    {
                        "phase": "introduction",
                        "speakers": ["user1", "user2"],
                        "topic": "Unboxing and checking parts",
                        "mood": "Optimistic",
                        "note": "They review the instruction manual"
                    },
                    {
                        "phase": "problem",
                        "speakers": ["user1", "user2"],
                        "topic": "Confusion about a specific step",
                        "mood": "Frustrated",
                        "note": "They can't tell which pieces connect"
                    },
                    {
                        "phase": "seeking_help",
                        "speakers": ["user1", "assistant", "user2"],
                        "topic": "Asking for clarification",
                        "mood": "Hopeful",
                        "note": "They address Sigma and describe the step number"
                    },
                    {
                        "phase": "assistance_request",
                        "speakers": ["assistant", "user1", "user2"],
                        "topic": "Getting simplified assembly guidance",
                        "mood": "Reassured",
                        "note": "Assistant explains orientation and tool usage"
                    },
                    {
                        "phase": "discussion",
                        "speakers": ["user1", "user2", "assistant"],
                        "topic": "Holding and securing parts together",
                        "mood": "Cooperative",
                        "note": "They verify alignment before tightening"
                    },
                    {
                        "phase": "followup",
                        "speakers": ["user1", "assistant", "user2"],
                        "topic": "Stability and safety tips",
                        "mood": "Careful",
                        "note": "Assistant suggests final checks"
                    },
                    {
                        "phase": "conclusion",
                        "speakers": ["user1", "user2"],
                        "topic": "Finishing the build",
                        "mood": "Proud and accomplished",
                        "note": "They test and celebrate the result"
                    }
                ],
                "complexity": "moderate",
                "max_turns": 14,
                "min_turns": 8
            }
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Person who is motivated to get household tasks done efficiently but has limited practical experience and can become overwhelmed when multiple steps or tools are involved",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "user2": {
            "name": "User2",
            "role": "Person who is detail-oriented and willing to help but often second-guesses decisions and looks for confirmation before proceeding with unfamiliar household tasks",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "assistant": {
            "name": "Assistant",
            "role": "Home task assistant that provides clear, structured, and practical step-by-step instructions, helps users prioritize actions, suggests time-saving methods, and offers safe alternatives when tools, materials, or knowledge are missing",
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.6
            },
            "history_enabled": true,
            "max_turns": 10
        }
    }
}
