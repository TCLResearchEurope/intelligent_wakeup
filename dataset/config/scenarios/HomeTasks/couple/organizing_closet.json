{
    "name": "OrganizingCloset",
    "framework_config": {
        "custom": {
            "system_prompt": "You are generating home tasks conversations.",
            "chat_loops": 4,
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            }
        }
    },
    "tts_config": {
        "model": "OpenAI_Audio_mini",
        "language": "en",
        "assistant": {"name": "Sigma", "tts_prompt": "Energetic"}
    },
    "sound_effects_config": {
        "model": "StableAudio",
        "prompt": "Radio in the background",
        "duration": 20.0
    },
    "initial_prompt": "Create a collaborative home task conversation with alternating turns where users work together to complete a household activity and consult the assistant for guidance when needed.",
    "default_characters": {
        "single_user": {
            "user1": {"name": "User1", "backstory": "", "tts_prompt": "Enthusiastic"},
            "user2": {"name": "User2", "backstory": "", "tts_prompt": "Enthusiastic"}
        },
        "multi_user": {
            "user1": {"name": "Declan", "backstory_file": "declan.txt", "tts_prompt": "Calm and steady"},
            "user2": {"name": "Renata", "backstory_file": "renata.txt", "tts_prompt": "Enthusiastic"}
        }
    },
    "variations": [
            {
				"context": "Decluttering and storage planning",
				"setting": {
					"mood": "Reflective and productive",
					"relationship_dynamic": "Friends helping each other reorganize",
					"background": "They want a more minimalist space",
					"conversation_style": "Supportive with decision-making moments"
				},
				"scenario_template": [
					{
						"phase": "introduction",
						"speakers": ["user1", "user2"],
						"topic": "Emptying the closet",
						"mood": "Overwhelmed but motivated",
						"note": "They categorize items into piles"
					},
					{
						"phase": "problem",
						"speakers": ["user1", "user2"],
						"topic": "Not knowing what to keep or donate",
						"mood": "Indecisive",
						"note": "They hesitate over sentimental items"
					},
					{
						"phase": "seeking_help",
						"speakers": ["user1", "assistant", "user2"],
						"topic": "Asking for a decluttering method",
						"mood": "Hopeful",
						"note": "They ask for help and describe the space"
					},
					{
						"phase": "assistance_request",
						"speakers": ["assistant", "user1", "user2"],
						"topic": "Receiving an organizing framework",
						"mood": "Encouraged",
						"note": "Assistant suggests categories and storage solutions"
					},
					{
						"phase": "discussion",
						"speakers": ["user1", "user2", "assistant"],
						"topic": "Arranging items by frequency of use",
						"mood": "Focused",
						"note": "They confirm layout ideas"
					},
					{
						"phase": "followup",
						"speakers": ["user1", "assistant", "user2"],
						"topic": "Maintaining organization long-term",
						"mood": "Forward-looking",
						"note": "Assistant gives habit tips"
					},
					{
						"phase": "conclusion",
						"speakers": ["user1", "user2"],
						"topic": "Seeing the finished closet",
						"mood": "Calm and satisfied",
						"note": "They enjoy the extra space"
					}
				],
				"complexity": "moderate",
				"max_turns": 13,
				"min_turns": 7
			}
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Person who is motivated to get household tasks done efficiently but has limited practical experience and can become overwhelmed when multiple steps or tools are involved",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "user2": {
            "name": "User2",
            "role": "Person who is detail-oriented and willing to help but often second-guesses decisions and looks for confirmation before proceeding with unfamiliar household tasks",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "assistant": {
            "name": "Assistant",
            "role": "Home task assistant that provides clear, structured, and practical step-by-step instructions, helps users prioritize actions, suggests time-saving methods, and offers safe alternatives when tools, materials, or knowledge are missing",
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.6
            },
            "history_enabled": true,
            "max_turns": 10
        }
    }
}
