        "assistant": {
            "name": "Sigma",
            "tts_prompt": "Wise"
        }
    },
    "sound_effects_config": {
        "model": "ElevenLabs",
        "prompt": "Computer noise and keyboard clicks in the background",
        "duration": 20.0
    },
    "initial_prompt": "Create a collaborative philosophical discussion with alternating turns where users discuss philosophical statements referencing todays day and age.",
    "default_characters": {
        "single_user": {
            "user1": {
                "name": "User1",
                "backstory": "",
                "tts_prompt": "Enthusiastic"
            },
            "user2": {
                "name": "User2",
                "backstory": "",
                "tts_prompt": "Enthusiastic"
            }
        },
        "multi_user": {
            "user1": {
                "name": "Oliver",
                "backstory_file": "oliver.txt",
                "tts_prompt": "Calm and steady"
            },
            "user2": {
                "name": "Petra",
                "backstory_file": "petra.txt",
                "tts_prompt": "Enthusiastic"
            }
        }
    },
    "variations": [
        {
            "context": "Building a balanced team for a turn-based RPG",
            "setting": {
                "mood": "Strategic and engaged",
                "relationship_dynamic": "Friends theorycrafting together",
                "background": "They have several favorite characters but their current team lacks balance",
                "conversation_style": "Analytical and enthusiastic"
            },
            "scenario_template": [
                {
                    "phase": "introduction",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Listing their favorite characters",
                    "mood": "Enthusiastic",
                    "note": "They want to include favorites even if they are not optimal"
                },
                {
                    "phase": "problem",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Identifying weaknesses in the current team",
                    "mood": "Concerned",
                    "note": "They lack reliable answers to certain enemy types"
                },
                {
                    "phase": "seeking_help",
                    "speakers": [
                        "user1",
                        "assistant",
                        "user2"
                    ],
                    "topic": "Asking how to balance the roster",
                    "mood": "Curious",
                    "note": "They explain which characters they refuse to replace"
                },
                {
                    "phase": "assistance_request",
                    "speakers": [
                        "assistant",
                        "user1",
                        "user2"
                    ],
                    "topic": "Assigning roles within the team",
                    "mood": "Focused",
                    "note": "Assistant explains damage, support, defense, and utility roles"
                },
                {
                    "phase": "discussion",
                    "speakers": [
                        "user1",
                        "user2",
                        "assistant"
                    ],
                    "topic": "Comparing different team combinations",
                    "mood": "Analytical",
                    "note": "They test several combinations against likely challenges"
                },
                {
                    "phase": "followup",
                    "speakers": [
                        "user1",
                        "assistant",
                        "user2"
                    ],
                    "topic": "Preparing alternate team members",
                    "mood": "Prepared",
                    "note": "Assistant recommends flexible substitutes"
                },
                {
                    "phase": "conclusion",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Finalizing the team",
                    "mood": "Satisfied",
                    "note": "They feel their favorites can still work together"
                }
            ],
            "complexity": "high",
            "max_turns": 16,
            "min_turns": 8
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Person who is motivated to improve at a game but has limited experience with its mechanics, strategies, or systems and can become overwhelmed when faced with many choices, unfamiliar terminology, or complex objectives.",
            "model_config": {
                "name": "gpt-4",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "user2": {
            "name": "User2",
            "role": "Person who is organized and detail-oriented, willing to help plan strategies and optimize gameplay, but tends to overthink decisions, double-check approaches, and seek confirmation when dealing with unfamiliar game mechanics or uncertain outcomes.",
            "model_config": {
                "name": "gpt-4",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "assistant": {
            "name": "Assistant",
            "role": "Gaming guide that provides clear, structured, and practical guidance for understanding game mechanics, progressing efficiently, choosing strategies or builds, and completing objectives, while adapting recommendations to the user's skill level, preferred playstyle, available resources, and constraints.",
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        }
    }
}
