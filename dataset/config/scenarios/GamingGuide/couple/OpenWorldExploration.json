            },
            "user2": {
                "name": "User2",
                "backstory": "",
                "tts_prompt": "Enthusiastic"
            }
        },
        "multi_user": {
            "user1": {
                "name": "Tobias",
                "backstory_file": "tobias.txt",
                "tts_prompt": "Calm and steady"
            },
            "user2": {
                "name": "Fang",
                "backstory_file": "fang.txt",
                "tts_prompt": "Enthusiastic"
            }
        }
    },
    "variations": [
        {
            "context": "Planning an efficient open-world exploration route",
            "setting": {
                "mood": "Adventurous and curious",
                "relationship_dynamic": "Friends exploring a large game world together",
                "background": "They want to discover secrets while avoiding unnecessary backtracking",
                "conversation_style": "Exploratory and practical"
            },
            "scenario_template": [
                {
                    "phase": "introduction",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Sharing interesting locations they discovered",
                    "mood": "Excited",
                    "note": "They compare landmarks and unexplored areas"
                },
                {
                    "phase": "problem",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Getting lost and repeatedly revisiting areas",
                    "mood": "Frustrated",
                    "note": "They realize their exploration has become inefficient"
                },
                {
                    "phase": "seeking_help",
                    "speakers": [
                        "user1",
                        "assistant",
                        "user2"
                    ],
                    "topic": "Asking for a sensible exploration strategy",
                    "mood": "Curious",
                    "note": "They want to avoid spoilers"
                },
                {
                    "phase": "assistance_request",
                    "speakers": [
                        "assistant",
                        "user1",
                        "user2"
                    ],
                    "topic": "Organizing exploration by region and objectives",
                    "mood": "Reassured",
                    "note": "Assistant proposes a flexible route"
                },
                {
                    "phase": "discussion",
                    "speakers": [
                        "user1",
                        "user2",
                        "assistant"
                    ],
                    "topic": "Balancing quests, collectibles, and exploration",
                    "mood": "Engaged",
                    "note": "They decide which objectives matter most"
                },
                {
                    "phase": "followup",
                    "speakers": [
                        "user1",
                        "assistant",
                        "user2"
                    ],
                    "topic": "Avoiding unnecessary detours",
                    "mood": "Organized",
                    "note": "Assistant suggests prioritization rules"
                },
                {
                    "phase": "conclusion",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Starting their new exploration plan",
                    "mood": "Adventurous",
                    "note": "They are eager to uncover more of the world"
                }
            ],
            "complexity": "moderate",
            "max_turns": 14,
            "min_turns": 7
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Person who is motivated to improve at a game but has limited experience with its mechanics, strategies, or systems and can become overwhelmed when faced with many choices, unfamiliar terminology, or complex objectives.",
            "model_config": {
                "name": "gpt-4",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "user2": {
            "name": "User2",
            "role": "Person who is organized and detail-oriented, willing to help plan strategies and optimize gameplay, but tends to overthink decisions, double-check approaches, and seek confirmation when dealing with unfamiliar game mechanics or uncertain outcomes.",
            "model_config": {
                "name": "gpt-4",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "assistant": {
            "name": "Assistant",
            "role": "Gaming guide that provides clear, structured, and practical guidance for understanding game mechanics, progressing efficiently, choosing strategies or builds, and completing objectives, while adapting recommendations to the user's skill level, preferred playstyle, available resources, and constraints.",
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        }
    }
