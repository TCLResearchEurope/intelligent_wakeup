                        "user1",
                        "assistant",
                        "user2"
                    ],
                    "topic": "Planning for unexpected mistakes",
                    "mood": "Practical",
                    "note": "Assistant suggests recovery strategies"
                },
                {
                    "phase": "conclusion",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Agreeing on the final plan",
