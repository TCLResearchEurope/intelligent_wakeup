            },
            "user2": {
                "name": "User2",
                "backstory": "",
                "tts_prompt": "Enthusiastic"
            }
        },
        "multi_user": {
            "user1": {
                "name": "Wei",
                "backstory_file": "wei.txt",
                "tts_prompt": "Calm and steady"
            },
            "user2": {
                "name": "Steffi",
                "backstory_file": "steffi.txt",
                "tts_prompt": "Enthusiastic"
            }
        }
    },
    "variations": [
        {
            "context": "Planning a speedrun practice session",
            "setting": {
                "mood": "Focused and energetic",
                "relationship_dynamic": "Friends practicing a game together",
                "background": "They are interested in improving their time without immediately pursuing a serious record",
                "conversation_style": "Technical and encouraging"
            },
            "scenario_template": [
                {
                    "phase": "introduction",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Comparing current completion times",
                    "mood": "Competitive",
                    "note": "They jokingly compete over small improvements"
                },
                {
                    "phase": "problem",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Losing too much time in specific sections",
                    "mood": "Frustrated",
                    "note": "They cannot tell which improvements are most valuable"
                },
                {
                    "phase": "seeking_help",
                    "speakers": [
                        "user1",
                        "assistant",
                        "user2"
                    ],
                    "topic": "Asking how to structure practice",
                    "mood": "Motivated",
                    "note": "They want an achievable training plan"
                },
                {
                    "phase": "assistance_request",
                    "speakers": [
                        "assistant",
                        "user1",
                        "user2"
                    ],
                    "topic": "Breaking the run into practice segments",
                    "mood": "Focused",
                    "note": "Assistant recommends isolating difficult sections"
                },
                {
                    "phase": "discussion",
                    "speakers": [
                        "user1",
                        "user2",
                        "assistant"
                    ],
                    "topic": "Comparing consistency against risky shortcuts",
                    "mood": "Competitive",
                    "note": "They debate whether faster techniques are worth practicing"
                },
                {
                    "phase": "followup",
                    "speakers": [
                        "user1",
                        "assistant",
                        "user2"
                    ],
                    "topic": "Handling failed attempts",
                    "mood": "Resilient",
                    "note": "Assistant suggests ways to learn from resets without burning out"
                },
                {
                    "phase": "conclusion",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Setting a realistic next time goal",
                    "mood": "Motivated",
                    "note": "They agree on a modest improvement target"
                }
            ],
            "complexity": "high",
            "max_turns": 16,
            "min_turns": 8
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Person who is motivated to improve at a game but has limited experience with its mechanics, strategies, or systems and can become overwhelmed when faced with many choices, unfamiliar terminology, or complex objectives.",
