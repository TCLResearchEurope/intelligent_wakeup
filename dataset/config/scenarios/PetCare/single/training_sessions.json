{
    "name": "PetTrainingSessions",
    "framework_config": {
        "custom": {
            "system_prompt": "You are generating conversations during pet training sessions with guidance on techniques and behavior modification.",
            "chat_loops": 6,
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            }
        }
    },
    "tts_config": {
        "model": "OpenAI_Audio",
        "language": "en",
        "assistant": {
            "name": "Sigma",
            "tts_prompt": "Helpful and supportive"
        }
    },
    "sound_effects_config": {
        "model": "ElevenLabs",
        "default_background": "home environment with gentle pet sounds and training activities",
        "default_duration": 35.0
    },
    "initial_prompt": "Create a conversation during pet training where a pet owner discusses training techniques, behavior challenges, and progress while the assistant provides training reminders and session tracking.",
    "default_characters": {
        "single_user": {
            "user1": {
                "name": "PetOwner",
                "backstory": "",
                "tts_prompt": "Patient and caring pet owner tone"
            }
        },
        "multi_user": {
            "user1": {
                "name": "Joey",
                "backstory_file": "joey.txt",
                "tts_prompt": "Dedicated dog owner voice"
            },
            "user2": {
                "name": "Mei",
                "backstory_file": "mei.txt",
                "tts_prompt": "Experienced pet trainer"
            }
        }
    },
    "variations": [
        {
            "context": "Pet training session",
            "setting": {
                "mood": "Patient and encouraging pet training atmosphere",
                "relationship_dynamic": "Pet owner working on training their pet",
                "background": "They use their home assistant to track training progress and set reminders",
                "conversation_style": "Caring, focused on positive pet training methods"
            },
            "scenario_template": [
                {
                    "phase": "training_start",
                    "speakers": [
                        "user1"
                    ],
                    "topic": "Beginning pet training session",
                    "mood": "Patient and focused",
                    "note": "Discussing today's training goals with assistant"
                },
                {
                    "phase": "training_discussion",
                    "speakers": [
                        "user1"
                    ],
                    "topic": "Working through training techniques",
                    "mood": "Supportive and encouraging",
                    "note": "User discusses training experiences and seeks advice"
                },
                {
                    "phase": "progress_tracking",
                    "speakers": [
                        "assistant",
                        "user1"
                    ],
                    "topic": "Tracking training progress",
                    "mood": "Helpful and organized",
                    "note": "Assistant helps track progress or set training reminders"
                },
                {
                    "phase": "pet_memories",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Sharing a favorite pet memory",
                    "mood": "Nostalgic and warm",
                    "note": "User recalls a memorable moment with their pet, creating a personal connection."
                },
                {
                    "phase": "tech_glitch",
                    "speakers": [
                        "user1",
                        "user1"
                    ],
                    "topic": "Dealing with a minor tech issue",
                    "mood": "Light frustration with humor",
                    "note": "User encounters a small glitch with the assistant and jokes about technology."
                },
                {
                    "phase": "unexpected_trick",
                    "speakers": [
                        "user2",
                        "user1"
                    ],
                    "topic": "Pet performs an unexpected trick",
                    "mood": "Surprised and delighted",
                    "note": "User notices their pet does something unexpected, adding a pleasant surprise."
                },
                {
                    "phase": "future_ideas",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Brainstorming future training ideas",
                    "mood": "Optimistic and creative",
                    "note": "User brainstorms potential new tricks or methods to try in the future."
                },
                {
                    "phase": "pet_distraction",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Pet becomes distracted by surroundings",
                    "mood": "Lighthearted and amused",
                    "note": "User1 and User2 observe as the pet gets distracted by something unexpected, sharing a laugh."
                },
                {
                    "phase": "session_notes",
                    "speakers": [
                        "user1",
                        "assistant"
                    ],
                    "topic": "Recording training session notes",
                    "mood": "Organized and reflective",
                    "note": "Assistant helps organize training notes and next steps"
                }
            ],
            "complexity": "medium",
            "max_turns": 16,
            "min_turns": 9
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "DedicatedOwner",
            "role": "Pet owner working on training who discusses behavioral issues, progress, and training challenges",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 15
        },
        "assistant": {
            "name": "Assistant",
            "role": "Home assistant that helps track training progress, set training reminders, and organize pet care notes and schedules",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.6
            },
            "history_enabled": true,
            "max_turns": 12
        }
    }
}
