{
    "name": "PetTrainingSessions",
    "framework_config": {
        "custom": {
            "system_prompt": "You are generating conversations during pet training sessions with guidance on techniques and behavior modification.",
            "chat_loops": 6,
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            }
        }
    },
    "tts_config": {
        "model": "ElevenLabs",
        "language": "en",
        "assistant": {
            "name": "Sigma",
            "tts_prompt": "Helpful and supportive"
        }
    },
    "sound_effects_config": {
        "model": "ElevenLabs",
        "default_background": "home environment with gentle pet sounds and training activities",
        "default_duration": 35.0
    },
    "initial_prompt": "Create a conversation during pet training where owners discuss training techniques, behavior challenges, and progress while the assistant provides training reminders and session tracking.",
    "default_characters": {
        "single_user": {
            "user1": {
                "name": "PetOwner",
                "backstory": "",
                "tts_prompt": "Patient and caring pet owner tone"
            }
        },
        "multi_user": {
            "user1": {
                "name": "Ilan",
                "backstory_file": "ilan.txt",
                "tts_prompt": "Dedicated dog owner voice"
            },
            "user2": {
                "name": "Aisha",
                "backstory_file": "aisha.txt",
                "tts_prompt": "Experienced pet trainer"
            }
        }
    },
    "variations": [
        {
            "context": "Pet training session",
            "setting": {
                "mood": "Patient and encouraging pet training atmosphere",
                "relationship_dynamic": "Pet owners working together on training their pet",
                "background": "They use their home assistant to track training progress and set reminders",
                "conversation_style": "Caring, focused on positive pet training methods"
            },
            "scenario_template": [
                {
                    "phase": "training_start",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Beginning pet training session",
                    "mood": "Patient and focused",
                    "note": "Discussing today's training goals"
                },
                {
                    "phase": "training_discussion",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Working through training techniques",
                    "mood": "Supportive and encouraging",
                    "note": "Partners share training experiences and advice"
                },
                {
                    "phase": "progress_tracking",
                    "speakers": [
                        "assistant",
                        "user1",
                        "user2"
                    ],
                    "topic": "Tracking training progress",
                    "mood": "Helpful and organized",
                    "note": "Assistant helps track progress or set training reminders"
                },
                {
                    "phase": "session_notes",
                    "speakers": [
                        "user1",
                        "assistant",
                        "user2"
                    ],
                    "topic": "Recording training session notes",
                    "mood": "Organized and reflective",
                    "note": "Assistant helps organize training notes and next steps"
                }
            ],
            "complexity": "medium",
            "max_turns": 10,
            "min_turns": 6
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "DedicatedOwner",
            "role": "Pet owner working on training who discusses behavioral issues, progress, and training challenges",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 15
        },
        "user2": {
            "name": "TrainingHelper",
            "role": "Person assisting with pet training who provides support and shares training experiences",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 15
        },
        "assistant": {
            "name": "Assistant",
            "role": "Home assistant that helps track training progress, set training reminders, and organize pet care notes and schedules",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.6
            },
            "history_enabled": true,
            "max_turns": 12
        }
    }
}
