            "scenario_template": [
                {
                    "phase": "behavior_observation",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Discussing pet's recent behavior",
                    "mood": "Observational and caring",
                    "note": "Sharing what they've noticed about their pet"
                },
                {
                    "phase": "pattern_discussion",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Analyzing behavior patterns",
                    "mood": "Thoughtful and analytical",
                    "note": "Discussing what behaviors might mean"
                },
                {
                    "phase": "note_taking",
                    "speakers": [
                        "user1",
                        "assistant",
                        "user2"
                    ],
                    "topic": "Recording behavior observations",
                    "mood": "Organized and helpful",
                    "note": "Assistant offers to take notes about pet behavior"
                },
                {
                    "phase": "care_planning",
                    "speakers": [
                        "assistant",
                        "user1",
                        "user2"
                    ],
                    "topic": "Planning pet care actions",
                    "mood": "Caring and proactive",
                    "note": "Assistant helps set reminders for pet care tasks"
                }
            ],
            "complexity": "simple",
            "max_turns": 10,
            "min_turns": 6
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "CuriousOwner",
            "role": "Pet owner who observes their pet's behavior and discusses patterns, quirks, and concerns about their pet's wellbeing",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 12
        },
        "user2": {
            "name": "PetCoOwner",
            "role": "Pet co-owner who shares observations about pet behavior and discusses pet care experiences and concerns",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 12
        },
        "assistant": {
            "name": "Assistant",
            "role": "Home assistant that listens to pet behavior discussions and offers to take notes, set reminders for pet care tasks, or provide basic information when helpful",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.6
            },
            "history_enabled": true,
