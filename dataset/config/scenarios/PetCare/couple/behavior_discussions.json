    "initial_prompt": "Create a conversation where pet owners discuss their pet's behavior patterns, needs, and personality while the home assistant listens and occasionally offers to help with notes or reminders.",
    "default_characters": {
        "single_user": {
            "user1": {
                "name": "ObservantOwner",
                "backstory": "",
                "tts_prompt": "Thoughtful and caring pet observer tone"
            },
            "user2": {
                "name": "PetCoOwner",
                "backstory": "",
                "tts_prompt": "Observant pet co-owner"
            }
        },
        "multi_user": {
            "user1": {
                "name": "Leo",
                "backstory_file": "leo.txt",
                "tts_prompt": "Curious pet owner voice"
            },
            "user2": {
                "name": "Juliet",
                "backstory_file": "juliet.txt",
                "tts_prompt": "Observant pet co-owner"
            }
        }
    },
    "variations": [
        {
            "context": "Pet behavior observation discussion",
            "setting": {
                "mood": "Caring and observational pet discussion",
                "relationship_dynamic": "Pet owners who share observations and care for their pet together",
                "background": "They use their home assistant to take notes about pet behavior and set care reminders",
                "conversation_style": "Caring, focused on understanding their pet's needs and wellbeing"
