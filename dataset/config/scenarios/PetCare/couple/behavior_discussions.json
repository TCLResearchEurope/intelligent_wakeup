{
    "name": "PetBehaviorDiscussions",
    "framework_config": {
        "custom": {
            "system_prompt": "You are generating conversations about pet behavior analysis and understanding pet needs.",
            "chat_loops": 5,
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.8
            }
        }
    },
    "tts_config": {
        "model": "ElevenLabs",
        "language": "en",
        "assistant": {
            "name": "Sigma",
            "tts_prompt": "Helpful and supportive"
        }
    },
    "sound_effects_config": {
        "model": "ElevenLabs",
        "default_background": "peaceful home environment with occasional gentle pet sounds",
