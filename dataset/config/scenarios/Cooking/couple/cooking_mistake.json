{
    "name": "CookingMistake",
    "framework_config": {
        "custom": {
            "system_prompt": "You are generating cooking assistance conversations.",
            "chat_loops": 4,
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            }
        }
    },
    "tts_config": {
        "model": "OpenAI_Audio_mini",
        "language": "en",
        "assistant": {"name": "Sigma", "tts_prompt": "Energetic"}
    },
    "sound_effects_config": {
        "model": "StableAudio",
        "prompt": "Cooking in the kitchen",
        "duration": 20.0
    },
    "initial_prompt": "Create a cooking conversation with alternating turns where users are preparing a meal together.",
    "default_characters": {
        "single_user": {
            "user1": {"name": "User1", "backstory": "", "tts_prompt": "Enthusiastic"},
            "user2": {"name": "User2", "backstory": "", "tts_prompt": "Enthusiastic"}
        },
        "multi_user": {
            "user1": {"name": "Marcus", "backstory_file": "marcus.txt", "tts_prompt": "Calm and steady"},
            "user2": {"name": "Elena", "backstory_file": "elena.txt", "tts_prompt": "Enthusiastic"}
        }
    },
    "variations": [
			{
				"context": "Recovering from a kitchen error",
				"setting": {
					"mood": "Initially tense but turning humorous",
					"relationship_dynamic": "Couple handling a small kitchen crisis",
					"background": "They are still building confidence in cooking",
					"conversation_style": "Emotional shifts from panic to laughter"
				},
				"scenario_template": [
					{
						"phase": "introduction",
						"speakers": ["user1", "user2"],
						"topic": "Starting a familiar recipe",
						"mood": "Comfortable and optimistic",
						"note": "They expect it to be easy"
					},
					{
						"phase": "problem",
						"speakers": ["user1", "user2"],
						"topic": "Accidentally overcooking or overseasoning",
						"mood": "Alarmed",
						"note": "They blame themselves playfully"
					},
					{
						"phase": "seeking_help",
						"speakers": ["user1", "assistant", "user2"],
						"topic": "Asking how to fix the mistake",
						"mood": "Urgent but hopeful",
						"note": "They ask for help and describe the issue"
					},
					{
						"phase": "assistance_request",
						"speakers": ["assistant", "user1", "user2"],
						"topic": "Receiving recovery strategies",
						"mood": "Relieved",
						"note": "Assistant gives quick corrective actions"
					},
					{
						"phase": "discussion",
						"speakers": ["user1", "user2", "assistant"],
						"topic": "Applying the fix",
						"mood": "Careful and cooperative",
						"note": "They check if the flavor improves"
					},
					{
						"phase": "followup",
						"speakers": ["user1", "assistant", "user2"],
						"topic": "Preventing the mistake next time",
						"mood": "Reflective",
						"note": "Assistant shares simple best practices"
					},
					{
						"phase": "conclusion",
						"speakers": ["user1", "user2"],
						"topic": "Saving the meal",
						"mood": "Relieved and amused",
						"note": "They joke about the experience and enjoy the result"
					}
				],
				"complexity": "moderate",
				"max_turns": 14,
				"min_turns": 7
			}
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Person with basic cooking skills who's eager to learn but gets easily overwhelmed by complex recipes",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "user2": {
            "name": "User2",
            "role": "Person who enjoys cooking but lacks confidence, often seeking clarification and reassurance during the process",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "assistant": {
            "name": "Assistant",
            "role": "Cooking assistant providing clear, concise guidance with a focus on simplifying complex techniques and suggesting alternatives for missing ingredients",
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.6
            },
            "history_enabled": true,
            "max_turns": 10
        }
    }
}
