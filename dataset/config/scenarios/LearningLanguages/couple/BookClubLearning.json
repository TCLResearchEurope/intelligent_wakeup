{
    "name": "BookClubLearning",
    "framework_config": {
        "custom": {
            "system_prompt": "You are generating conversations which focus on learning new languages.",
            "chat_loops": 4,
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            }
        }
    },
    "tts_config": {
        "model": "ElevenLabs",
        "language": "en",
        "assistant": {
            "name": "Sigma",
            "tts_prompt": "Wise"
        }
    },
    "sound_effects_config": {
        "model": "ElevenLabs",
        "prompt": "Street noise in the background",
        "duration": 20.0
    },
    "initial_prompt": "Create a collaborative conversation that focuses on learning new languages and learning new cultures.",
    "default_characters": {
        "single_user": {
            "user1": {
                "name": "User1",
                "backstory": "",
                "tts_prompt": "Enthusiastic"
            },
            "user2": {
                "name": "User2",
                "backstory": "",
                "tts_prompt": "Enthusiastic"
            }
        },
        "multi_user": {
            "user1": {
                "name": "Marcus",
                "backstory_file": "marcus.txt",
                "tts_prompt": "Calm and steady"
            },
            "user2": {
                "name": "Steffi",
                "backstory_file": "steffi.txt",
                "tts_prompt": "Enthusiastic"
            }
        }
    },
    "variations": [
        {
            "context": "Learning a language through a shared book club",
            "setting": {
                "mood": "Thoughtful and social",
                "relationship_dynamic": "Friends starting a bilingual book club",
                "background": "They want to read literature while developing vocabulary and discussion skills",
                "conversation_style": "Reflective and analytical"
            },
            "scenario_template": [
                {
                    "phase": "introduction",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Choosing a manageable book",
                    "mood": "Curious",
                    "note": "They compare literary interest with language difficulty"
                },
                {
                    "phase": "problem",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Finding too many unfamiliar words",
                    "mood": "Overwhelmed",
                    "note": "They worry that constant dictionary use will ruin the reading experience"
                },
                {
                    "phase": "seeking_help",
                    "speakers": [
                        "user1",
                        "assistant",
                        "user2"
                    ],
                    "topic": "Developing a balanced reading strategy",
                    "mood": "Hopeful",
                    "note": "They ask when to look words up and when to infer meaning"
                },
                {
                    "phase": "assistance_request",
                    "speakers": [
                        "assistant",
                        "user1",
                        "user2"
                    ],
                    "topic": "Preparing discussion questions in the target language",
                    "mood": "Engaged",
                    "note": "Assistant suggests questions at different difficulty levels"
                },
                {
                    "phase": "discussion",
                    "speakers": [
                        "user1",
                        "user2",
                        "assistant"
                    ],
                    "topic": "Discussing a character or theme",
                    "mood": "Thoughtful",
                    "note": "They practice expressing opinions and agreeing or disagreeing"
                },
                {
                    "phase": "followup",
                    "speakers": [
                        "user1",
                        "assistant",
                        "user2"
                    ],
                    "topic": "Finding more natural ways to express opinions",
                    "mood": "Curious",
                    "note": "Assistant provides alternative discussion phrases"
                },
                {
                    "phase": "conclusion",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Choosing the next reading goal",
                    "mood": "Satisfied",
                    "note": "They decide to continue with another chapter"
                }
            ],
            "complexity": "moderate",
            "max_turns": 15,
            "min_turns": 7,
            "variant_name": "BookClubLearning"
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Person who is motivated to learn and use a new language but has limited proficiency and can become overwhelmed when faced with unfamiliar vocabulary, grammar rules, pronunciation challenges, or too many concepts at once.",
            "model_config": {
                "name": "gpt-4",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "user2": {
            "name": "User2",
            "role": "Person who is organized and detail-oriented, willing to help plan and practice language learning, but tends to overthink grammar, double-check phrasing and pronunciation, and seek confirmation when unsure whether an expression is correct or natural.",
            "model_config": {
                "name": "gpt-4",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "assistant": {
            "name": "Assistant",
            "role": "Language-learning assistant that provides clear, structured, and practical guidance for building vocabulary, understanding grammar, improving pronunciation, and practicing communication, adapts explanations and exercises to the user's proficiency level and goals, and offers corrections, examples, and alternative expressions when appropriate.",
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        }
    }
}
