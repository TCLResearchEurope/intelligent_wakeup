{
    "name": "SpanishWeekendGetaway",
    "framework_config": {
        "custom": {
            "system_prompt": "You are generating conversations which focus on learning new languages.",
            "chat_loops": 4,
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            }
        }
    },
    "tts_config": {
        "model": "ElevenLabs",
        "language": "en",
        "assistant": {
            "name": "Sigma",
            "tts_prompt": "Wise"
        }
    },
    "sound_effects_config": {
        "model": "ElevenLabs",
        "prompt": "Street noise in the background",
        "duration": 20.0
    },
    "initial_prompt": "Create a collaborative conversation that focuses on learning new languages and learning new cultures.",
    "default_characters": {
        "single_user": {
            "user1": {
                "name": "User1",
                "backstory": "",
                "tts_prompt": "Enthusiastic"
            },
            "user2": {
                "name": "User2",
                "backstory": "",
                "tts_prompt": "Enthusiastic"
            }
        },
        "multi_user": {
            "user1": {
                "name": "Ingmar",
                "backstory_file": "ingmar.txt",
                "tts_prompt": "Calm and steady"
            },
            "user2": {
                "name": "Aaliya",
                "backstory_file": "aaliya.txt",
                "tts_prompt": "Enthusiastic"
            }
        }
    },
    "variations": [
        {
            "context": "Practicing Spanish through planning a weekend itinerary",
            "setting": {
                "mood": "Energetic and practical",
                "relationship_dynamic": "Friends organizing a city weekend",
                "background": "They want to practice language while making real plans",
                "conversation_style": "Planning-oriented and conversational"
            },
            "scenario_template": [
                {
                    "phase": "introduction",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Choosing activities for the weekend",
                    "mood": "Excited",
                    "note": "They list museums, restaurants, and outdoor activities"
                },
                {
                    "phase": "problem",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Lacking vocabulary for making plans",
                    "mood": "Uncertain",
                    "note": "They struggle with times, preferences, and suggestions"
                },
                {
                    "phase": "seeking_help",
                    "speakers": [
                        "user1",
                        "assistant",
                        "user2"
                    ],
                    "topic": "Learning phrases for making and changing plans",
                    "mood": "Hopeful",
                    "note": "They ask for flexible conversational patterns"
                },
                {
                    "phase": "assistance_request",
                    "speakers": [
                        "assistant",
                        "user1",
                        "user2"
                    ],
                    "topic": "Practicing suggestions and disagreements",
                    "mood": "Engaged",
                    "note": "Assistant provides natural ways to agree or disagree"
                },
                {
                    "phase": "discussion",
                    "speakers": [
                        "user1",
                        "user2",
                        "assistant"
                    ],
                    "topic": "Role-playing the itinerary discussion",
                    "mood": "Lively",
                    "note": "They negotiate activities and timing in the target language"
                },
                {
                    "phase": "followup",
                    "speakers": [
                        "user1",
                        "assistant",
                        "user2"
                    ],
                    "topic": "Handling last-minute changes",
                    "mood": "Problem-solving",
                    "note": "Assistant introduces useful contingency phrases"
                },
                {
                    "phase": "conclusion",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Finalizing the weekend plan",
                    "mood": "Satisfied",
                    "note": "They have practiced practical conversational language"
                }
            ],
            "complexity": "moderate",
            "max_turns": 15,
            "min_turns": 7
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Person who is motivated to learn and use a new language but has limited proficiency and can become overwhelmed when faced with unfamiliar vocabulary, grammar rules, pronunciation challenges, or too many concepts at once.",
            "model_config": {
                "name": "gpt-4",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "user2": {
            "name": "User2",
            "role": "Person who is organized and detail-oriented, willing to help plan and practice language learning, but tends to overthink grammar, double-check phrasing and pronunciation, and seek confirmation when unsure whether an expression is correct or natural.",
            "model_config": {
                "name": "gpt-4",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "assistant": {
            "name": "Assistant",
            "role": "Language-learning assistant that provides clear, structured, and practical guidance for building vocabulary, understanding grammar, improving pronunciation, and practicing communication, adapts explanations and exercises to the user's proficiency level and goals, and offers corrections, examples, and alternative expressions when appropriate.",
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        }
    }
}
