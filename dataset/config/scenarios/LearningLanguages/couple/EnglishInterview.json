{
    "name": "EnglishInterview",
    "framework_config": {
        "custom": {
            "system_prompt": "You are generating conversations which focus on learning new languages.",
            "chat_loops": 4,
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            }
        }
    },
    "tts_config": {
        "model": "ElevenLabs",
        "language": "en",
        "assistant": {
            "name": "Sigma",
            "tts_prompt": "Wise"
        }
    },
    "sound_effects_config": {
        "model": "ElevenLabs",
        "prompt": "Street noise in the background",
        "duration": 20.0
    },
    "initial_prompt": "Create a collaborative conversation that focuses on learning new languages and learning new cultures.",
    "default_characters": {
        "single_user": {
            "user1": {
                "name": "User1",
                "backstory": "",
                "tts_prompt": "Enthusiastic"
            },
            "user2": {
                "name": "User2",
                "backstory": "",
                "tts_prompt": "Enthusiastic"
            }
        },
        "multi_user": {
            "user1": {
                "name": "Chen",
                "backstory_file": "chen.txt",
                "tts_prompt": "Calm and steady"
            },
            "user2": {
                "name": "Tessa",
                "backstory_file": "tessa.txt",
                "tts_prompt": "Enthusiastic"
            }
        }
    },
    "variations": [
        {
            "context": "Helping a friend prepare for an English job interview",
            "setting": {
                "mood": "Supportive and mildly anxious",
                "relationship_dynamic": "Close friends practicing together",
                "background": "One friend speaks English reasonably well but lacks confidence",
                "conversation_style": "Coaching and conversational"
            },
            "scenario_template": [
                {
                    "phase": "introduction",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Discussing the upcoming interview",
                    "mood": "Nervous",
                    "note": "They identify common interview questions"
                },
                {
                    "phase": "problem",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Struggling to answer spontaneously",
                    "mood": "Frustrated",
                    "note": "User1 tends to translate answers mentally"
                },
                {
                    "phase": "seeking_help",
                    "speakers": [
                        "user1",
                        "assistant",
                        "user2"
                    ],
                    "topic": "Practicing interview answers",
                    "mood": "Hopeful",
                    "note": "They ask the assistant to act as an interviewer"
                },
                {
                    "phase": "assistance_request",
                    "speakers": [
                        "assistant",
                        "user1",
                        "user2"
                    ],
                    "topic": "Improving clarity and natural phrasing",
                    "mood": "Focused",
                    "note": "Assistant gives corrections without making answers overly formal"
                },
                {
                    "phase": "discussion",
                    "speakers": [
                        "user1",
                        "user2",
                        "assistant"
                    ],
                    "topic": "Role-playing common interview questions",
                    "mood": "Serious and collaborative",
                    "note": "They practice strengths, weaknesses, and previous experience"
                },
                {
                    "phase": "followup",
                    "speakers": [
                        "user1",
                        "assistant",
                        "user2"
                    ],
                    "topic": "Finding simpler ways to express difficult ideas",
                    "mood": "Relieved",
                    "note": "Assistant suggests flexible vocabulary"
                },
                {
                    "phase": "conclusion",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Repeating the strongest answers",
                    "mood": "Confident",
                    "note": "They agree on a short practice routine"
                }
            ],
            "complexity": "moderate",
            "max_turns": 15,
            "min_turns": 7
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Person who is motivated to learn and use a new language but has limited proficiency and can become overwhelmed when faced with unfamiliar vocabulary, grammar rules, pronunciation challenges, or too many concepts at once.",
            "model_config": {
                "name": "gpt-4",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "user2": {
            "name": "User2",
            "role": "Person who is organized and detail-oriented, willing to help plan and practice language learning, but tends to overthink grammar, double-check phrasing and pronunciation, and seek confirmation when unsure whether an expression is correct or natural.",
            "model_config": {
                "name": "gpt-4",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "assistant": {
            "name": "Assistant",
            "role": "Language-learning assistant that provides clear, structured, and practical guidance for building vocabulary, understanding grammar, improving pronunciation, and practicing communication, adapts explanations and exercises to the user's proficiency level and goals, and offers corrections, examples, and alternative expressions when appropriate.",
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        }
    }
}
