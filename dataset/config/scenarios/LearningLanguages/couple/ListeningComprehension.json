{
    "name": "ListeningComprehension",
    "framework_config": {
        "custom": {
            "system_prompt": "You are generating conversations which focus on learning new languages.",
            "chat_loops": 4,
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            }
        }
    },
    "tts_config": {
        "model": "ElevenLabs",
        "language": "en",
        "assistant": {
            "name": "Sigma",
            "tts_prompt": "Wise"
        }
    },
    "sound_effects_config": {
        "model": "ElevenLabs",
        "prompt": "Street noise in the background",
        "duration": 20.0
    },
    "initial_prompt": "Create a collaborative conversation that focuses on learning new languages and learning new cultures.",
    "default_characters": {
        "single_user": {
            "user1": {
                "name": "User1",
                "backstory": "",
                "tts_prompt": "Enthusiastic"
            },
            "user2": {
                "name": "User2",
                "backstory": "",
                "tts_prompt": "Enthusiastic"
            }
        },
        "multi_user": {
            "user1": {
                "name": "Jamal",
                "backstory_file": "jamal.txt",
                "tts_prompt": "Calm and steady"
            },
            "user2": {
                "name": "Betty",
                "backstory_file": "betty.txt",
                "tts_prompt": "Enthusiastic"
            }
        }
    },
    "variations": [
        {
            "context": "Improving listening comprehension with podcasts",
            "setting": {
                "mood": "Focused and curious",
                "relationship_dynamic": "Study partners comparing learning methods",
                "background": "They can read the target language better than they can understand spoken conversation",
                "conversation_style": "Analytical and collaborative"
            },
            "scenario_template": [
                {
                    "phase": "introduction",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Comparing their listening difficulties",
                    "mood": "Reflective",
                    "note": "They identify speed and unfamiliar accents as challenges"
                },
                {
                    "phase": "problem",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Understanding individual words but missing the overall meaning",
                    "mood": "Frustrated",
                    "note": "They pause too often to translate"
                },
                {
                    "phase": "seeking_help",
                    "speakers": [
                        "user1",
                        "assistant",
                        "user2"
                    ],
                    "topic": "Developing a better listening approach",
                    "mood": "Hopeful",
                    "note": "They ask how to work with short audio segments"
                },
                {
                    "phase": "assistance_request",
                    "speakers": [
                        "assistant",
                        "user1",
                        "user2"
                    ],
                    "topic": "Using repeated listening and context clues",
                    "mood": "Focused",
                    "note": "Assistant explains a staged listening process"
                },
                {
                    "phase": "discussion",
                    "speakers": [
                        "user1",
                        "user2",
                        "assistant"
                    ],
                    "topic": "Analyzing a short imagined podcast segment",
                    "mood": "Investigative",
                    "note": "They predict meaning before checking details"
                },
                {
                    "phase": "followup",
                    "speakers": [
                        "user1",
                        "assistant",
                        "user2"
                    ],
                    "topic": "Handling words they cannot identify",
                    "mood": "Reassured",
                    "note": "Assistant encourages focusing on meaning rather than every word"
                },
                {
                    "phase": "conclusion",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Choosing a listening routine",
                    "mood": "Motivated",
                    "note": "They agree to use shorter recordings consistently"
                }
            ],
            "complexity": "moderate",
            "max_turns": 14,
            "min_turns": 7,
            "variant_name": "ListeningComprehension"
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Person who is motivated to learn and use a new language but has limited proficiency and can become overwhelmed when faced with unfamiliar vocabulary, grammar rules, pronunciation challenges, or too many concepts at once.",
            "model_config": {
                "name": "gpt-4",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "user2": {
            "name": "User2",
            "role": "Person who is organized and detail-oriented, willing to help plan and practice language learning, but tends to overthink grammar, double-check phrasing and pronunciation, and seek confirmation when unsure whether an expression is correct or natural.",
            "model_config": {
                "name": "gpt-4",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "assistant": {
            "name": "Assistant",
            "role": "Language-learning assistant that provides clear, structured, and practical guidance for building vocabulary, understanding grammar, improving pronunciation, and practicing communication, adapts explanations and exercises to the user's proficiency level and goals, and offers corrections, examples, and alternative expressions when appropriate.",
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        }
    }
}
