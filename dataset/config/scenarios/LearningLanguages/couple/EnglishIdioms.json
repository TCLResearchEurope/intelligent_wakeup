{
    "name": "EnglishIdioms",
    "framework_config": {
        "custom": {
            "system_prompt": "You are generating conversations which focus on learning new languages.",
            "chat_loops": 4,
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            }
        }
    },
    "tts_config": {
        "model": "ElevenLabs",
        "language": "en",
        "assistant": {
            "name": "Sigma",
            "tts_prompt": "Wise"
        }
    },
    "sound_effects_config": {
        "model": "ElevenLabs",
        "prompt": "Street noise in the background",
        "duration": 20.0
    },
    "initial_prompt": "Create a collaborative conversation that focuses on learning new languages and learning new cultures.",
    "default_characters": {
        "single_user": {
            "user1": {
                "name": "User1",
                "backstory": "",
                "tts_prompt": "Enthusiastic"
            },
            "user2": {
                "name": "User2",
                "backstory": "",
                "tts_prompt": "Enthusiastic"
            }
        },
        "multi_user": {
            "user1": {
                "name": "Kai",
                "backstory_file": "kai.txt",
                "tts_prompt": "Calm and steady"
            },
            "user2": {
                "name": "Freja",
                "backstory_file": "freja.txt",
                "tts_prompt": "Enthusiastic"
            }
        }
    },
    "variations": [
        {
            "context": "Learning English idioms through everyday situations",
            "setting": {
                "mood": "Curious and playful",
                "relationship_dynamic": "Friends discussing confusing things they have heard",
                "background": "One learner understands standard English but finds idioms confusing",
                "conversation_style": "Conversational and humorous"
            },
            "scenario_template": [
                {
                    "phase": "introduction",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Sharing strange expressions they have heard",
                    "mood": "Amused",
                    "note": "They compare literal interpretations"
                },
                {
                    "phase": "problem",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Not knowing when idioms are appropriate",
                    "mood": "Confused",
                    "note": "They worry about sounding unnatural"
                },
                {
                    "phase": "seeking_help",
                    "speakers": [
                        "user1",
                        "assistant",
                        "user2"
                    ],
                    "topic": "Understanding idioms in context",
                    "mood": "Curious",
                    "note": "They ask for realistic examples"
                },
                {
                    "phase": "assistance_request",
                    "speakers": [
                        "assistant",
                        "user1",
                        "user2"
                    ],
                    "topic": "Comparing literal and figurative meanings",
                    "mood": "Playful",
                    "note": "Assistant explains tone and common usage"
                },
                {
                    "phase": "discussion",
                    "speakers": [
                        "user1",
                        "user2",
                        "assistant"
                    ],
                    "topic": "Using idioms in short conversations",
                    "mood": "Amused",
                    "note": "They try to invent situations where each expression fits"
                },
                {
                    "phase": "followup",
                    "speakers": [
                        "user1",
                        "assistant",
                        "user2"
                    ],
                    "topic": "Avoiding overly dramatic or outdated expressions",
                    "mood": "Thoughtful",
                    "note": "Assistant distinguishes common modern usage"
                },
                {
                    "phase": "conclusion",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Selecting a few idioms to start using",
                    "mood": "Confident",
                    "note": "They choose expressions that fit their personalities"
                }
            ],
            "complexity": "moderate",
            "max_turns": 14,
            "min_turns": 7
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Person who is motivated to learn and use a new language but has limited proficiency and can become overwhelmed when faced with unfamiliar vocabulary, grammar rules, pronunciation challenges, or too many concepts at once.",
            "model_config": {
                "name": "gpt-4",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "user2": {
            "name": "User2",
            "role": "Person who is organized and detail-oriented, willing to help plan and practice language learning, but tends to overthink grammar, double-check phrasing and pronunciation, and seek confirmation when unsure whether an expression is correct or natural.",
            "model_config": {
                "name": "gpt-4",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "assistant": {
            "name": "Assistant",
            "role": "Language-learning assistant that provides clear, structured, and practical guidance for building vocabulary, understanding grammar, improving pronunciation, and practicing communication, adapts explanations and exercises to the user's proficiency level and goals, and offers corrections, examples, and alternative expressions when appropriate.",
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        }
    }
}
