{
    "name": "ConceptClarification",
    "framework_config": {
        "custom": {
            "system_prompt": "You are generating educational conversations where users want to expand their knowledge and learn new things.",
            "chat_loops": 4,
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            }
        }
    },
    "tts_config": {
        "model": "ElevenLabs",
        "language": "en",
        "assistant": {
            "name": "Sigma",
            "tts_prompt": "Patient and encouraging educational assistant"
        }
    },
    "sound_effects_config": {
        "model": "ElevenLabs",
        "prompt": "Quiet study room with papers and books",
        "duration": 25.0
    },
    "initial_prompt": "Create an education and learning conversation with alternating turns where users collaborate to understand new material, plan their learning process, and improve study strategies.",
    "default_characters": {
        "single_user": {
            "user1": {
                "name": "User1",
                "backstory": "",
                "tts_prompt": "Energetic"
            },
            "user2": {
                "name": "User2",
                "backstory": "",
                "tts_prompt": "Energetic"
            }
        },
        "multi_user": {
            "user1": {
                "name": "Timo",
                "backstory_file": "timo.txt",
                "tts_prompt": "Calm and steady"
            },
            "user2": {
                "name": "Anja",
                "backstory_file": "anja.txt",
                "tts_prompt": "Energetic"
            }
        }
    },
    "variations": [
        {
            "context": "Trying to deeply understand a difficult abstract concept",
            "setting": {
                "mood": "Curious and reflective",
                "relationship_dynamic": "Peers with different learning preferences",
                "background": "They encountered a topic that neither fully understands",
                "conversation_style": "Exploratory and explanatory"
            },
            "scenario_template": [
                {
                    "phase": "introduction",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Admitting confusion about the same concept",
                    "mood": "Open and curious",
                    "note": "They describe what feels unclear"
                },
                {
                    "phase": "problem",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Conflicting explanations from different resources",
                    "mood": "Frustrated",
                    "note": "They struggle to connect theory and intuition"
                },
                {
                    "phase": "seeking_help",
                    "speakers": [
                        "user2",
                        "assistant",
                        "user1"
                    ],
                    "topic": "Requesting multiple explanations and real-life analogies",
                    "mood": "Inquisitive",
                    "note": "They ask for both formal and intuitive views"
                },
                {
                    "phase": "assistance_request",
                    "speakers": [
                        "assistant",
                        "user1",
                        "user2"
                    ],
                    "topic": "Receiving layered explanations of the concept",
                    "mood": "Enlightened",
                    "note": "Assistant bridges learning styles"
                },
                {
                    "phase": "discussion",
                    "speakers": [
                        "user1",
                        "user2",
                        "assistant"
                    ],
                    "topic": "Testing understanding by rephrasing the idea",
                    "mood": "Analytical",
                    "note": "They explain it in their own words"
                },
                {
                    "phase": "followup",
                    "speakers": [
                        "user1",
                        "assistant",
                        "user2"
                    ],
                    "topic": "Applying the concept to an example",
                    "mood": "Confident",
                    "note": "Assistant verifies their reasoning"
                },
                {
                    "phase": "conclusion",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Recognizing their improved understanding",
                    "mood": "Satisfied",
                    "note": "They plan how to remember it"
                }
            ],
            "complexity": "moderate",
            "max_turns": 14,
            "min_turns": 8
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Learner who is curious and motivated but often feels overwhelmed by the amount of information and unsure how to structure their learning effectively",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "user2": {
            "name": "User2",
            "role": "Learner who prefers structured and methodical approaches, frequently asking for clarification and validation to ensure deep understanding",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "assistant": {
            "name": "Assistant",
            "role": "Educational learning assistant who explains concepts clearly, adapts to different learning styles, suggests effective study techniques, and helps users plan, reflect, and stay engaged",
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.6
            },
            "history_enabled": true,
            "max_turns": 10
        }
    }
}
