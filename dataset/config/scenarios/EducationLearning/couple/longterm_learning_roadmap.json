{
    "name": "LongtermLearningRoadmap",
    "framework_config": {
        "custom": {
            "system_prompt": "You are generating educational conversations where users want to expand their knowledge and learn new things.",
            "chat_loops": 4,
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            }
        }
    },
    "tts_config": {
        "model": "OpenAI_Audio",
        "language": "en",
        "assistant": {"name": "Sigma", "tts_prompt": "Patient and encouraging educational assistant"}
    },
    "sound_effects_config": {
        "model": "ElevenLabs",
        "prompt": "Quiet study room with papers and books",
        "duration": 25.0
    },
    "initial_prompt": "Create an education and learning conversation with alternating turns where users collaborate to understand new material, plan their learning process, and improve study strategies.",
    "default_characters": {
        "single_user": {
            "user1": {"name": "User1", "backstory": "", "tts_prompt": "Energetic"},
            "user2": {"name": "User2", "backstory": "", "tts_prompt": "Energetic"}
        },
        "multi_user": {
            "user1": {"name": "Timo", "backstory_file": "timo.txt", "tts_prompt": "Calm and steady"},
            "user2": {"name": "Anja", "backstory_file": "anja.txt", "tts_prompt": "Energetic"}
        }
    },
    "variations": [
        {
            "context": "Designing a long-term roadmap for learning a completely new field",
            "setting": {
                "mood": "Visionary and motivated",
                "relationship_dynamic": "Learning partners exploring a shared interest",
                "background": "They want to learn but feel lost among too many resources",
                "conversation_style": "Strategic and future-oriented"
            },
            "scenario_template": [
                {
                    "phase": "introduction",
                    "speakers": ["user1", "user2"],
                    "topic": "Discussing why they want to learn the subject",
                    "mood": "Inspired",
                    "note": "They define their long-term goals"
                },
                {
                    "phase": "problem",
                    "speakers": ["user1", "user2"],
                    "topic": "Too many courses, books, and tutorials to choose from",
                    "mood": "Confused",
                    "note": "They fear wasting time on the wrong materials"
                },
                {
                    "phase": "seeking_help",
                    "speakers": ["user1", "assistant", "user2"],
                    "topic": "Asking how to structure a clear learning roadmap",
                    "mood": "Curious",
                    "note": "They describe their current level"
                },
                {
                    "phase": "assistance_request",
                    "speakers": ["assistant", "user2", "user1"],
                    "topic": "Receiving milestone-based learning stages",
                    "mood": "Encouraged",
                    "note": "Assistant balances theory and practice"
                },
                {
                    "phase": "discussion",
                    "speakers": ["user2", "user1", "assistant"],
                    "topic": "Choosing the first learning resources",
                    "mood": "Decisive",
                    "note": "They simplify their options"
                },
                {
                    "phase": "followup",
                    "speakers": ["user1", "assistant", "user2"],
                    "topic": "Planning progress tracking and review moments",
                    "mood": "Organized",
                    "note": "Assistant suggests reflection checkpoints"
                },
                {
                    "phase": "conclusion",
                    "speakers": ["user1", "user2"],
                    "topic": "Starting the first milestone",
                    "mood": "Excited and committed",
                    "note": "They define a realistic first step"
                }
            ],
            "complexity": "complex",
            "max_turns": 16,
            "min_turns": 9
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Learner who is curious and motivated but often feels overwhelmed by the amount of information and unsure how to structure their learning effectively",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "user2": {
            "name": "User2",
            "role": "Learner who prefers structured and methodical approaches, frequently asking for clarification and validation to ensure deep understanding",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "assistant": {
            "name": "Assistant",
            "role": "Educational learning assistant who explains concepts clearly, adapts to different learning styles, suggests effective study techniques, and helps users plan, reflect, and stay engaged",
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.6
            },
            "history_enabled": true,
            "max_turns": 10
        }
  }
}
