{
    "name": "SelfAssesment",
    "framework_config": {
        "custom": {
            "system_prompt": "You are generating educational conversations where users want to expand their knowledge and learn new things.",
            "chat_loops": 4,
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            }
        }
    },
    "tts_config": {
        "model": "OpenAI_Audio",
        "language": "en",
        "assistant": {"name": "Sigma", "tts_prompt": "Patient and encouraging educational assistant"}
    },
    "sound_effects_config": {
        "model": "ElevenLabs",
        "prompt": "Quiet study room with papers and books",
        "duration": 25.0
    },
    "initial_prompt": "Create an education and learning conversation with alternating turns where users collaborate to understand new material, plan their learning process, and improve study strategies.",
    "default_characters": {
        "single_user": {
            "user1": {"name": "User1", "backstory": "", "tts_prompt": "Energetic"},
            "user2": {"name": "User2", "backstory": "", "tts_prompt": "Energetic"}
        },
        "multi_user": {
            "user1": {"name": "Timo", "backstory_file": "timo.txt", "tts_prompt": "Calm and steady"},
            "user2": {"name": "Anja", "backstory_file": "anja.txt", "tts_prompt": "Energetic"}
        }
    },
    "variations": [
        {
            "context": "Evaluating what they truly understand before moving forward",
            "setting": {
                "mood": "Honest and analytical",
                "relationship_dynamic": "Supportive peers encouraging reflection",
                "background": "They studied a lot but are unsure about actual mastery",
                "conversation_style": "Metacognitive and diagnostic"
            },
            "scenario_template": [
                {
                    "phase": "introduction",
                    "speakers": ["user1", "user2"],
                    "topic": "Comparing confidence levels in the subject",
                    "mood": "Reflective",
                    "note": "They notice a mismatch between effort and results"
                },
                {
                    "phase": "problem",
                    "speakers": ["user2", "user1"],
                    "topic": "Not knowing how to test real understanding",
                    "mood": "Uncertain",
                    "note": "They rely on misleading signals like rereading"
                },
                {
                    "phase": "seeking_help",
                    "speakers": ["user2", "assistant", "user1"],
                    "topic": "Asking for ways to diagnose knowledge gaps",
                    "mood": "Curious",
                    "note": "They want objective evaluation methods"
                },
                {
                    "phase": "assistance_request",
                    "speakers": ["assistant", "user1", "user2"],
                    "topic": "Receiving self-testing and reflection techniques",
                    "mood": "Enlightened",
                    "note": "Assistant introduces calibration strategies"
                },
                {
                    "phase": "discussion",
                    "speakers": ["user1", "user2", "assistant"],
                    "topic": "Applying confidence-based self-assessment",
                    "mood": "Analytical",
                    "note": "They identify weak areas"
                },
                {
                    "phase": "followup",
                    "speakers": ["user1", "assistant", "user2"],
                    "topic": "Planning targeted review sessions",
                    "mood": "Strategic",
                    "note": "Assistant helps prioritize gaps"
                },
                {
                    "phase": "conclusion",
                    "speakers": ["user1", "user2"],
                    "topic": "Redefining their study approach",
                    "mood": "Clear-headed and motivated",
                    "note": "They feel more in control of learning"
                }
            ],
            "complexity": "complex",
            "max_turns": 15,
            "min_turns": 9
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Learner who is curious and motivated but often feels overwhelmed by the amount of information and unsure how to structure their learning effectively",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "user2": {
            "name": "User2",
            "role": "Learner who prefers structured and methodical approaches, frequently asking for clarification and validation to ensure deep understanding",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "assistant": {
            "name": "Assistant",
            "role": "Educational learning assistant who explains concepts clearly, adapts to different learning styles, suggests effective study techniques, and helps users plan, reflect, and stay engaged",
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.6
            },
            "history_enabled": true,
            "max_turns": 10
        }
  }
}
