{
    "name": "ReelFilming",
    "framework_config": {
        "custom": {
            "system_prompt": "You are generating conversations about creative hobbies.",
            "chat_loops": 6,
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            }
        }
    },
    "tts_config": {
        "model": "OpenAI_Audio",
        "language": "en",
        "assistant": {"name": "Sigma", "tts_prompt": "Helpful and supportive"}
    },
    "sound_effects_config": {
        "model": "ElevenLabs",
        "default_background": "home music with occasional traffic in the background",
        "default_duration": 35.0
    },
    "initial_prompt": "Create a conversation with alternating turns where users work together on a creative hobby project and consult the assistant for techniques, inspiration, and constructive feedback.",
    "default_characters": {
        "single_user": {
            "user1": {"name": "User1", "backstory": "", "tts_prompt": "Energetic"},
            "user2": {"name": "User2", "backstory": "", "tts_prompt": "Energetic"}
        },
        "multi_user": {
            "user1": {"name": "Timo", "backstory_file": "timo.txt", "tts_prompt": "Calm and steady"},
            "user2": {"name": "Harriet", "backstory_file": "harriet.txt", "tts_prompt": "Energetic"}
        }
    },
    "variations": [
        {
            "context": "Planning and shooting a short-form video",
            "setting": {
                "mood": "Energetic and trend-aware",
                "relationship_dynamic": "Friends collaborating on content",
                "background": "They want something visually engaging with simple tools",
                "conversation_style": "Fast-paced and idea-driven"
            },
            "scenario_template": [
                {
                    "phase": "introduction",
                    "speakers": ["user1", "user2"],
                    "topic": "Choosing a concept and style",
                    "mood": "Excited",
                    "note": "They reference trends and available space"
                },
                {
                    "phase": "problem",
                    "speakers": ["user1", "user2"],
                    "topic": "Uncertainty about shot composition",
                    "mood": "Unsure",
                    "note": "They want it to look dynamic"
                },
                {
                    "phase": "seeking_help",
                    "speakers": ["user1", "assistant", "user2"],
                    "topic": "Asking for simple filming techniques",
                    "mood": "Curious",
                    "note": "They ask for help and describe their setup"
                },
                {
                    "phase": "assistance_request",
                    "speakers": ["assistant", "user1", "user2"],
                    "topic": "Getting a shot list and sequence",
                    "mood": "Motivated",
                    "note": "Assistant suggests camera angles and transitions"
                },
                {
                    "phase": "discussion",
                    "speakers": ["user1", "user2", "assistant"],
                    "topic": "Recording test clips",
                    "mood": "Playful and iterative",
                    "note": "They adjust framing and timing"
                },
                {
                    "phase": "followup",
                    "speakers": ["user1", "assistant", "user2"],
                    "topic": "Basic editing flow",
                    "mood": "Focused",
                    "note": "Assistant suggests pacing and effects"
                },
                {
                    "phase": "conclusion",
                    "speakers": ["user1", "user2"],
                    "topic": "Watching the final cut",
                    "mood": "Excited and proud",
                    "note": "They plan the upload"
                }
            ],
            "complexity": "moderate",
            "max_turns": 15,
            "min_turns": 8
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Person who is imaginative and eager to start new creative projects but often needs help structuring the process and choosing the right techniques",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.75
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "user2": {
            "name": "User2",
            "role": "Person who enjoys learning by doing and pays attention to details but sometimes lacks confidence in their creative decisions and seeks reassurance",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.75
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "assistant": {
            "name": "Assistant",
            "role": "Creative mentor that provides clear step-by-step guidance, explains techniques in an accessible way, encourages experimentation, and gives supportive, actionable feedback",
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.65
            },
            "history_enabled": true,
            "max_turns": 10
        }
  }
}
