{
    "name": "GardeningSession",
    "framework_config": {
        "custom": {
            "system_prompt": "You are generating conversations during gardening sessions with guidance.",
            "chat_loops": 5,
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.8
            }
        }
    },
    "tts_config": {
        "model": "ElevenLabs",
        "language": "en",
        "assistant": {
            "name": "Sigma",
            "tts_prompt": "Helpful and supportive"
        }
    },
    "sound_effects_config": {
        "model": "ElevenLabs",
        "default_background": "quiet garden with birds chirping and gentle rustling leaves",
        "default_duration": 30.0
    },
    "initial_prompt": "Create a conversation during a gardening session where a user discusses plant care, and makes a shopping list of missing supplies while the assistant provides gardening tips and makes the shopping list.",
    "default_characters": {
        "single_user": {
            "user1": {
                "name": "Gardener",
                "backstory": "",
                "tts_prompt": "Out of breath but enthusiastic gardener tone"
            }
        }
    },
    "variations": [
        {
            "context": "Gardening session",
            "setting": {
                "mood": "Relaxed and nurturing gardening atmosphere",
                "relationship_dynamic": "Individual focused on their garden",
                "background": "User uses their home assistant for information about plants and supply reminders",
                "conversation_style": "Focused, straight to the point about tasks and supplies"
            },
            "scenario_template": [
                {
                    "phase": "work_starts",
                    "speakers": [
                        "user1"
                    ],
                    "topic": "Beginning gardening session",
                    "mood": "Busy and determined",
                    "note": "Discussing plants conditions and tasks to be done"
                },
                {
                    "phase": "garden_description",
                    "speakers": [
                        "user1"
                    ],
                    "topic": "Sharing and discussing gardening tasks",
                    "mood": "Busy and determined",
                    "note": "User shares state of the garden with the assistant"
                },
                {
                    "phase": "plant_memory",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Recalling plant's history",
                    "mood": "Nostalgic and joyful",
                    "note": "User shares a personal story about the first plant they ever grew."
                },
                {
                    "phase": "unexpected_pest_discovery",
                    "speakers": [
                        "user1",
                        "user1"
                    ],
                    "topic": "Finding an unexpected pest issue",
                    "mood": "Concerned but proactive",
                    "note": "User spots a pest on a plant and discusses solutions with the assistant."
                },
                {
                    "phase": "weather_impact",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Effect of weather changes on plants",
                    "mood": "Informative and reassuring",
                    "note": "Assistant provides insights on how the recent weather affects plant growth."
                },
                {
                    "phase": "neighbor_garden_comparison",
                    "speakers": [
                        "user1",
                        "user1",
                        "user2"
                    ],
                    "topic": "Discussing neighbor's garden tactics",
                    "mood": "Curious and insightful",
                    "note": "User compares their garden with their neighbor's and seeks advice on different plant techniques."
                },
                {
                    "phase": "future_garden_plans",
                    "speakers": [
                        "user1",
                        "user2"
                    ],
                    "topic": "Thinking ahead about garden changes",
                    "mood": "Optimistic and strategic",
                    "note": "User shares ideas for future garden improvements and gets feedback from the assistant."
                },
                {
                    "phase": "list_tasks",
                    "speakers": [
                        "assistant",
                        "user1"
                    ],
                    "topic": "Creating task and supply list",
                    "mood": "Helpful and organized",
                    "note": "Assistant provides gardening tips and helps create a shopping list"
                }
            ],
            "complexity": "simple",
            "max_turns": 15,
            "min_turns": 9
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "Gardener",
            "role": "Person working in a garden who asks for gardening tips and help creating a shopping list for supplies",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 12
        },
        "assistant": {
            "name": "Assistant",
            "role": "Home assistant that provides gardening tips and helps create shopping lists for gardening supplies",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        }
    }
}
