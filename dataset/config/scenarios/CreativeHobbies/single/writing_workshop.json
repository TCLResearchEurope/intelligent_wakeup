{
    "name": "WritingWorkshop",
    "framework_config": {
        "custom": {
            "system_prompt": "You are generating conversations during creative writing sessions with feedback and writing guidance.",
            "chat_loops": 5,
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.8
            }
        }
    },
    "tts_config": {
        "model": "OpenAI_Audio",
        "language": "en",
        "assistant": {
            "name": "Sigma",
            "tts_prompt": "Helpful and supportive"
        }
    },
    "sound_effects_config": {
        "model": "ElevenLabs",
        "default_background": "quiet writing space with gentle typing and page turning sounds",
        "default_duration": 30.0
    },
    "initial_prompt": "Create a conversation during a creative writing session where a user discusses story ideas, writing techniques, and creative challenges while the assistant provides writing time reminders and scheduling support.",
    "default_characters": {
        "single_user": {
            "user1": {
                "name": "Writer",
                "backstory": "",
                "tts_prompt": "Thoughtful and creative writer tone"
            }
        },
        "multi_user": {
            "user1": {
                "name": "Maya",
                "backstory_file": "maya.txt",
                "tts_prompt": "Aspiring novelist voice"
            },
            "user2": {
                "name": "Timo",
                "backstory_file": "timo.txt",
                "tts_prompt": "Experienced writing mentor"
            }
        }
    },
    "variations": [
        {
            "context": "Creative writing session",
            "setting": {
                "mood": "Creative and encouraging writing atmosphere",
                "relationship_dynamic": "Individual focused on their creative writing projects",
                "background": "User uses their home assistant for writing time reminders and scheduling",
                "conversation_style": "Creative, focused on storytelling and writing craft"
            },
            "scenario_template": [
                {
                    "phase": "writing_start",
                    "speakers": [
                        "user1"
                    ],
                    "topic": "Beginning writing session",
                    "mood": "Creative and inspired",
                    "note": "Discussing writing projects and goals"
                },
                {
                    "phase": "creative_feedback",
                    "speakers": [
                        "user1"
                    ],
                    "topic": "Sharing and discussing writing",
                    "mood": "Supportive creative discussion",
                    "note": "User reflects on writing progress with assistant"
                },
                {
                    "phase": "time_reminder",
                    "speakers": [
                        "assistant",
                        "user1"
                    ],
                    "topic": "Writing time management",
                    "mood": "Helpful and organized",
                    "note": "Assistant provides writing time reminders or scheduling help"
                },
                {
                    "phase": "writing_progress",
                    "speakers": [
                        "user1"
                    ],
                    "topic": "Discussing creative progress",
                    "mood": "Encouraging and motivating",
                    "note": "User discusses their writing journey with assistant"
                }
            ],
            "complexity": "simple",
            "max_turns": 5,
            "min_turns": 3
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "CreativeWriter",
            "role": "Person working on creative writing who discusses plot ideas, character development, and writing challenges",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.8
            },
            "history_enabled": true,
            "max_turns": 12
        },
        "assistant": {
            "name": "Assistant",
            "role": "Home assistant that provides writing time reminders, session scheduling, and organizational support for writing activities",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        }
    }
}
