{
    "name": "ContentRecommendation",
    "framework_config": {
        "custom": {
            "system_prompt": "You are two flat-mates choosing a feel-good comedy on a rainy Sunday.",
            "chat_loops": 4,
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            }
        }
    },
    "tts_config": {
        "model": "Kokoro",
        "language": "en",
        "assistant": {"name": "Sigma", "tts_prompt": "Neutral"}
    },
    "sound_effects_config": {
        "model": "ElevenLabs",
        "prompt": "Rain",
        "duration": 30.0
    },
    "initial_prompt": "Create a natural conversation where a person browses a streaming app for a light comedy without involving the assistant.",
    "default_characters": {
        "single_user": {
            "user1": {"name": "User1", "backstory": "", "tts_prompt": "Casual"}
        },
        "multi_user": {
            "user1": {"name": "Timo", "backstory_file": "timo.txt", "tts_prompt": "Calm and steady"},
            "user2": {"name": "Ola", "backstory_file": "ola.txt", "tts_prompt": "Energetic"}
        }
    },
    "variations": [
        {
            "context": "Lazy Sunday streaming scroll",
            "setting": {
                "mood": "Relaxed, playful",
                "relationship_dynamic": "Individual browsing streaming content",
                "background": "User often unwinds with comedies while doing chores",
                "conversation_style": "Quick reactions to on-screen posters"
            },
            "scenario_template": [
                {
                    "phase": "introduction",
                    "speakers": ["user1"],
                    "topic": "Craving a feel-good comedy",
                    "mood": "Chatting about weather and mood",
                    "note": "Remote hum clicks in background; no assistant mentioned"
                },
                {
                    "phase": "scrolling_thumbnails",
                    "speakers": ["user1"],
                    "topic": "Browsing comedy row in streaming app",
                    "mood": "Playful suggestions and rejections",
                    "note": "Pattern: User1 highlights a poster — 'How about Hot Rod?' / User1: 'Nah, not into Andy Samberg today.'  Audible navigation beeps and thumbnail hover SFX."
                },
                {
                    "phase": "details_preview",
                    "speakers": ["user1"],
                    "topic": "Opening movie details panels",
                    "mood": "Curious evaluation",
                    "note": "User1 presses OK; synopsis pops up. They skim cast, runtime, rating. User1 considers, 'I like Emma Stone, but this one's 2 h 20 min—too long.'"
                },
                {
                    "phase": "shortlist",
                    "speakers": ["user1"],
                    "topic": "Narrowing to final contenders",
                    "mood": "Comparing runtimes and recent views",
                    "note": "Narrow down to two titles still visible in side-by-side mini-cards; brief consideration about which feels fresher."
                },
                {
                    "phase": "decision",
                    "speakers": ["user1"],
                    "topic": "Final pick and setup",
                    "mood": "Satisfied anticipation",
                    "note": "Remote click confirms selection; lights dim; snack bags rustle; user presses play."
                }
            ],
            "complexity": "simple",
            "max_turns": 10,
            "min_turns": 5
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Flat-mate who enjoys slapstick comedies",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "assistant": {
            "name": "Sigma",
            "role": "Virtual assistant (inactive in this scenario)",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.6
            },
            "history_enabled": true,
            "max_turns": 0
        }
    }
}
