                },
                {
                    "phase": "seeking_help",
                    "speakers": ["user1", "assistant"],
                    "topic": "Movie suggestions",
                    "mood": "Seeking common ground",
                    "note": "User explicitly addresses assistant as Sigma on first interaction"
                },
                {
                    "phase": "assistance_request",
                    "speakers": ["assistant", "user1"],
                    "topic": "Personalized film recommendations",
                    "mood": "Appreciative of thoughtful suggestions",
                    "note": "Assistant provides options that might appeal to user's tastes"
                },
                {
                    "phase": "discussion",
                    "speakers": ["user1", "assistant"],
                    "topic": "Evaluating film options",
                    "mood": "Intimate decision-making",
                    "note": "User discusses the suggested movies and their appeal"
                },
                {
                    "phase": "planning",
                    "speakers": ["user1", "assistant"],
                    "topic": "Creating the perfect movie experience",
                    "mood": "Romantic anticipation",
                    "note": "Assistant helps finalize the movie selection and suggest ambiance enhancements"
                },
                {
                    "phase": "conclusion",
                    "speakers": ["user1"],
                    "topic": "Looking forward to the evening",
                    "mood": "Affectionate anticipation",
                    "note": "User expresses excitement about their selected film and planned evening"
                }
            ],
            "complexity": "moderate",
            "max_turns": 12,
            "min_turns": 6,
            "agent_configs": {
                "user1": {
                    "additional_context": "Prefers classic romantic films and emotional storytelling"
                },
                "user2": {
                    "additional_context": "Enjoys films with both romance and elements of comedy or adventure"
                },
                "assistant": {
                    "additional_context": "Knowledgeable about films that successfully blend genres to appeal to different tastes"
                }
            }
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Partner who enjoys discovering new films through streaming services and recommendations, particularly those connected to travel experiences",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "assistant": {
            "name": "Assistant",
            "role": "Home assistant who helps discover films based on themes, moods, and interests, waiting to be asked before making suggestions",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.6
            },
            "history_enabled": true,
            "max_turns": 10
        }
