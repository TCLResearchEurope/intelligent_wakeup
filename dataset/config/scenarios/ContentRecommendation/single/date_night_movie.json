{
    "name": "ContentRecommendation",
    "framework_config": {
        "custom": {
            "system_prompt": "You are having a casual evening discussion about what to watch.",
            "chat_loops": 4,
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            }
        }
    },
    "tts_config": {
        "model": "Kokoro",
        "language": "en",
        "assistant": {"name": "Sigma", "tts_prompt": "Energetic"}
    },
    "sound_effects_config": {
        "model": "ElevenLabs",
        "prompt": "Vacuuming",
        "duration": 20.0
    },
    "initial_prompt": "Create a natural conversation about choosing an evening movie.",
    "default_characters": {
        "single_user": {
            "user1": {"name": "User1", "backstory": "", "tts_prompt": "Energetic"}
        },
        "multi_user": {
            "user1": {"name": "Timo", "backstory_file": "timo.txt", "tts_prompt": "Calm and steady"},
            "user2": {"name": "Bianca", "backstory_file": "bianca.txt", "tts_prompt": "Energetic"}
        }
    },
    "variations": [
        {
            "context": "Romantic date night movie selection",
            "setting": {
                "mood": "Intimate and relaxed evening planned",
                "relationship_dynamic": "Individual wanting to enjoy a special film",
                "background": "They want to find the perfect movie for a relaxing evening at home",
                "conversation_style": "Relaxed with thoughtful consideration about genre preferences"
            },
            "scenario_template": [
                {
                    "phase": "introduction",
                    "speakers": ["user1"],
                    "topic": "Planning relaxing evening",
                    "mood": "Warm and affectionate",
                    "note": "User discusses their plans for a relaxing evening"
                },
                {
                    "phase": "problem",
                    "speakers": ["user1"],
                    "topic": "Uncertain movie preferences",
                    "mood": "Playful negotiation",
