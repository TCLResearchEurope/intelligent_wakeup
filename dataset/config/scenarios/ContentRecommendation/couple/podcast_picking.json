{
    "name": "PodcastPicking",
    "framework_config": {
        "custom": {
            "system_prompt": "You are having a casual discussion about what podcast to listen to.",
            "chat_loops": 4,
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            }
        }
    },
    "tts_config": {
        "model": "Kokoro",
        "language": "en",
        "assistant": {"name": "Sigma", "tts_prompt": "Energetic"}
    },
    "sound_effects_config": {
        "model": "ElevenLabs",
        "prompt": "Vacuuming",
        "duration": 20.0
    },
    "initial_prompt": "Create a conversation with alternating turns where users decide what podcast to listen to together and ask the assistant for personalized recommendations based on their preferences.",
    "default_characters": {
        "single_user": {
            "user1": {"name": "User1", "backstory": "", "tts_prompt": "Energetic"},
            "user2": {"name": "User2", "backstory": "", "tts_prompt": "Energetic"}
        },
        "multi_user": {
            "user1": {"name": "Timo", "backstory_file": "timo.txt", "tts_prompt": "Calm and steady"},
            "user2": {"name": "Anja", "backstory_file": "anja.txt", "tts_prompt": "Energetic"}
        }
    },
    "variations": [
        {
            "context": "Choosing something to listen to on the go",
            "setting": {
                "mood": "Practical and time-aware",
                "relationship_dynamic": "Partners commuting at the same time",
                "background": "They want something that fits commute length",
                "conversation_style": "Efficient and preference-driven"
            },
            "scenario_template": [
                {
                    "phase": "introduction",
                    "speakers": ["user1", "user2"],
                    "topic": "Defining ideal episode length",
                    "mood": "Focused",
                    "note": "They consider daily routine constraints"
                },
                {
                    "phase": "problem",
                    "speakers": ["user1", "user2"],
                    "topic": "Not knowing which podcasts are worth starting",
                    "mood": "Unsure",
                    "note": "They want something engaging quickly"
                },
                {
                    "phase": "seeking_help",
                    "speakers": ["user1", "assistant", "user2"],
                    "topic": "Requesting tailored podcast suggestions",
                    "mood": "Hopeful",
                    "note": "They ask for suggestions and describe topics of interest"
                },
                {
                    "phase": "assistance_request",
                    "speakers": ["assistant", "user1", "user2"],
                    "topic": "Getting commute-friendly options",
                    "mood": "Relieved",
                    "note": "Assistant suggests specific episodes to start with"
                },
                {
                    "phase": "discussion",
                    "speakers": ["user1", "user2", "assistant"],
                    "topic": "Comparing tone and format",
                    "mood": "Thoughtful",
                    "note": "They ask about storytelling vs conversational style"
                },
                {
                    "phase": "followup",
                    "speakers": ["user1", "assistant", "user2"],
                    "topic": "Download and listening strategy",
                    "mood": "Prepared",
                    "note": "Assistant suggests a listening schedule"
                },
                {
                    "phase": "conclusion",
                    "speakers": ["user1", "user2"],
                    "topic": "Starting the first episode",
                    "mood": "Content and motivated",
                    "note": "They feel the commute will be more enjoyable"
                }
            ],
            "complexity": "moderate",
            "max_turns": 13,
            "min_turns": 7
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Person who has clear preferences and strong opinions about what they like but struggles to find options that match their mood in the moment",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "user2": {
            "name": "User2",
            "role": "Person who is open to suggestions and enjoys discovering new content but often needs help narrowing down choices and comparing options",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "assistant": {
            "name": "Assistant",
            "role": "Recommendation assistant that asks clarifying questions, balances multiple user preferences, and provides concise, tailored suggestions with brief explanations and alternative options",
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.6
            },
            "history_enabled": true,
            "max_turns": 10
        }
    }
}
