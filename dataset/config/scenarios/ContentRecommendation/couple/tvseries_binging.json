{
    "name": "TvSeriesBinging",
    "framework_config": {
        "custom": {
            "system_prompt": "You are having a casual discussion about what TV series to watch.",
            "chat_loops": 4,
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.7
            }
        }
    },
    "tts_config": {
        "model": "Kokoro",
        "language": "en",
        "assistant": {"name": "Sigma", "tts_prompt": "Energetic"}
    },
    "sound_effects_config": {
        "model": "ElevenLabs",
        "prompt": "Vacuuming",
        "duration": 20.0
    },
    "initial_prompt": "Create a conversation with alternating turns where users decide what tv series to binge together and ask the assistant for personalized recommendations based on their preferences.",
    "default_characters": {
        "single_user": {
            "user1": {"name": "User1", "backstory": "", "tts_prompt": "Energetic"},
            "user2": {"name": "User2", "backstory": "", "tts_prompt": "Energetic"}
        },
        "multi_user": {
            "user1": {"name": "Timo", "backstory_file": "timo.txt", "tts_prompt": "Calm and steady"},
            "user2": {"name": "Anja", "backstory_file": "anja.txt", "tts_prompt": "Energetic"}
        }
    },
    "variations": [
        {
            "context": "Looking for a long-form show",
            "setting": {
                "mood": "Weekend planning",
                "relationship_dynamic": "Friends planning shared watch time",
                "background": "They want something that keeps them engaged for weeks",
                "conversation_style": "Analytical with excitement about world-building"
            },
            "scenario_template": [
                {
                    "phase": "introduction",
                    "speakers": ["user1", "user2"],
                    "topic": "Defining what makes a good binge-worthy series",
                    "mood": "Curious",
                    "note": "They mention episode length and number of seasons"
                },
                {
                    "phase": "problem",
                    "speakers": ["user1", "user2"],
                    "topic": "Too many options and fear of wasting time",
                    "mood": "Overwhelmed",
                    "note": "They recall past disappointments"
                },
                {
                    "phase": "seeking_help",
                    "speakers": ["user1", "assistant", "user2"],
                    "topic": "Requesting highly engaging series recommendations",
                    "mood": "Hopeful",
                    "note": "They ask for recommendations and list liked shows"
                },
                {
                    "phase": "assistance_request",
                    "speakers": ["assistant", "user1", "user2"],
                    "topic": "Getting personalized series suggestions",
                    "mood": "Reassured",
                    "note": "Assistant highlights pacing and cliffhangers"
                },
                {
                    "phase": "discussion",
                    "speakers": ["user1", "user2", "assistant"],
                    "topic": "Evaluating commitment level",
                    "mood": "Thoughtful",
                    "note": "They ask about completion status and tone consistency"
                },
                {
                    "phase": "followup",
                    "speakers": ["user1", "assistant", "user2"],
                    "topic": "Choosing where to start",
                    "mood": "Decisive",
                    "note": "Assistant suggests a viewing plan"
                },
                {
                    "phase": "conclusion",
                    "speakers": ["user1", "user2"],
                    "topic": "Starting episode one",
                    "mood": "Excited",
                    "note": "They anticipate the experience"
                }
            ],
            "complexity": "moderate",
            "max_turns": 15,
            "min_turns": 8
        }
    ],
    "agent_configs": {
        "user1": {
            "name": "User1",
            "role": "Person who has clear preferences and strong opinions about what they like but struggles to find options that match their mood in the moment",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "user2": {
            "name": "User2",
            "role": "Person who is open to suggestions and enjoys discovering new content but often needs help narrowing down choices and comparing options",
            "model_config": {
                "name": "gpt-4o",
                "temperature": 0.7
            },
            "history_enabled": true,
            "max_turns": 10
        },
        "assistant": {
            "name": "Assistant",
            "role": "Recommendation assistant that asks clarifying questions, balances multiple user preferences, and provides concise, tailored suggestions with brief explanations and alternative options",
            "model_config": {
                "name": "gpt-3.5-turbo",
                "temperature": 0.6
            },
            "history_enabled": true,
            "max_turns": 10
        }
    }
}
