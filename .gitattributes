# Normalize line endings to LF on checkout
* text=auto eol=lf

# Python
*.py text eol=lf

# JSON
*.json text eol=lf

# Shell scripts
*.sh text eol=lf

# YAML
*.yml text eol=lf
*.yaml text eol=lf

# Markdown
*.md text eol=lf

# Binary files — do not modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.mp3 binary
*.flac binary
*.ogg binary
*.pt binary
*.pth binary
*.pkl binary
*.zip binary
