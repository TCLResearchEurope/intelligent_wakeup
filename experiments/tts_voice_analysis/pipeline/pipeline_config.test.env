#
# Minimal-scale mirror of pipeline_config.env, for smoke-testing the pipeline
# (does every step wire together correctly end-to-end) without generating a
# full-scale run. Use together with OUT=output_test so results don't land in
# (or overwrite) the real output/ directory:
#
#   CONFIG_FILE=pipeline/pipeline_config.test.env OUT=output_test ./pipeline/run_pipeline.sh
#
# Still makes real ElevenLabs/OpenAI/Qwen3-TTS API calls (just as few as
# possible) - this is a wiring smoke test, not a mock/offline test. Numbers
# here are NOT meant to be reproducible/meaningful results; see
# pipeline_config.env for the real run parameters. Every value below is itself
# still overridable via environment variable, e.g. to smoke-test with a
# different character: CHARACTER_NAMES=Aisha CONFIG_FILE=... OUT=... ./pipeline/run_pipeline.sh

# --- Generated voices (steps 1, 3) ---
N_UTTERANCES_PER_VOICE="${N_UTTERANCES_PER_VOICE:-1}"
TTS_MODEL_ID="${TTS_MODEL_ID:-eleven_multilingual_v2}"
LLM_MODEL="${LLM_MODEL:-gpt-4o-mini}"

# --- Natural reference corpus, VCTK (step 2) ---
VCTK_N_SPEAKERS="${VCTK_N_SPEAKERS:-1}"
VCTK_N_UTTERANCES="${VCTK_N_UTTERANCES:-1}"
VCTK_REVISION="${VCTK_REVISION:-73ef4ee7d49a6fed4ea1efd65f82b4c95faeb9de}"

# --- Speaker embedding encoders (steps 3, 4, 7, 11, 12) ---
ENCODERS="${ENCODERS:-ecapa wavlm_sv}"

# --- Channel perturbation control subset (step 6) ---
PERTURB_N_VOICES="${PERTURB_N_VOICES:-1}"
PERTURB_N_UTTERANCES_PER_VOICE="${PERTURB_N_UTTERANCES_PER_VOICE:-1}"

# --- Qwen3-TTS server (used by both the qwen_cloned and qwen_designed systems) ---
# Internally hosted; export QWEN_BASE_URL before running (see pipeline_config.env).
QWEN_BASE_URL="${QWEN_BASE_URL:-}"

# --- 3rd system: Qwen3-TTS voices cloned from LibriTTS speakers (steps 17-19) ---
QWEN_N_SPEAKERS="${QWEN_N_SPEAKERS:-1}"
QWEN_N_UTTERANCES="${QWEN_N_UTTERANCES:-1}"

# --- 4th system: Qwen3-TTS voice-designed voices (steps 21-24) ---
QWEN_DESIGN_LLM_MODEL="${QWEN_DESIGN_LLM_MODEL:-gpt-4o-mini}"

# --- Restrict the 3 character-based steps (diversity_utterances,
#     qwen_design_instructions, qwen_designed_speakers) to one character, so
#     their outputs all line up instead of each picking a different subset. ---
CHARACTER_NAMES="${CHARACTER_NAMES:-Timo}"
CHARACTER_LIMIT="${CHARACTER_LIMIT:-}"
