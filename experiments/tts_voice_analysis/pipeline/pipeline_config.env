#
# Canonical configuration for reproducing the tts_voice_analysis experiment
# (see RESULTS.md). Sourced by run_pipeline.sh, which passes every value below
# as an explicit CLI flag to each step - this file is the single source of
# truth, not the per-script argparse defaults (those exist only for ad hoc
# runs of an individual step and may drift from what a full run actually used).
#
# To reproduce RESULTS.md exactly: check out the git commit recorded in
# output/pipeline_provenance.json, then run `./run_pipeline.sh` with this file
# unchanged. LLM text and ElevenLabs audio are not bit-exact deterministic
# even with identical inputs; VCTK speaker selection is deterministic given
# the pinned VCTK_REVISION.

# --- Generated voices (steps 1, 3) ---
N_UTTERANCES_PER_VOICE="${N_UTTERANCES_PER_VOICE:-8}"
TTS_MODEL_ID="${TTS_MODEL_ID:-eleven_multilingual_v2}"
LLM_MODEL="${LLM_MODEL:-gpt-4o-mini}"

# --- Natural reference corpus, VCTK (step 2) ---
# VCTK only has ~109-110 speakers total; requesting more than that just
# exhausts the corpus (see output/vctk/provenance.json for what was actually
# found - as of this config, 109/150).
VCTK_N_SPEAKERS="${VCTK_N_SPEAKERS:-150}"
VCTK_N_UTTERANCES="${VCTK_N_UTTERANCES:-8}"
VCTK_REVISION="${VCTK_REVISION:-73ef4ee7d49a6fed4ea1efd65f82b4c95faeb9de}"

# --- Speaker embedding encoders (steps 3, 4, 7, 11, 12) ---
ENCODERS="${ENCODERS:-ecapa wavlm_sv}"

# --- Channel perturbation control subset (step 6) ---
# All 7 perturbations in channel_perturbations.py are applied (bandwidth_limit,
# eq_tilt, codec_gsm, codec_opus, noise_15db, noise_5db, reverb) - not
# individually listed here since apply_channel_perturbations.py defaults to
# "all" already and there's currently no reason to run a subset.
PERTURB_N_VOICES="${PERTURB_N_VOICES:-20}"
PERTURB_N_UTTERANCES_PER_VOICE="${PERTURB_N_UTTERANCES_PER_VOICE:-3}"

# --- Channel normalization (steps 9, 10) ---
# Not currently CLI-exposed; hardcoded in channel_normalization.py:
#   TARGET_DBFS=-20.0, bandpass 50-7900 Hz

# --- Qwen3-TTS server (used by both the qwen_cloned and qwen_designed systems) ---
# Internally hosted, not a public API, so no endpoint is committed here - export
# QWEN_BASE_URL in your shell (or set it just for the run) before invoking the
# pipeline, e.g. QWEN_BASE_URL=http://<host>:<port> ./pipeline/run_pipeline.sh.
# The steps that need it fail with an explicit message when it is unset; the
# other steps do not depend on it. The endpoint has moved before, and each run
# records whichever base_url was live at the time in its own provenance.json, so
# historical results stay interpretable regardless of what is set now.
QWEN_BASE_URL="${QWEN_BASE_URL:-}"
# Qwen3-TTS calls run strictly sequentially (not CLI-exposed as a knob - see
# generate_qwen_speakers.py / generate_qwen_designed_speakers.py) to stay
# conservative with a shared internal GPU box.

# --- 3rd system: Qwen3-TTS voices cloned from LibriTTS speakers (steps 17-19) ---
# LibriTTS-R train-clean-100 has 247 speakers; requesting more than needed just
# exhausts however many are needed to hit the target (see
# output/libritts_reference/provenance.json for what was actually found).
QWEN_N_SPEAKERS="${QWEN_N_SPEAKERS:-100}"
QWEN_N_UTTERANCES="${QWEN_N_UTTERANCES:-8}"

# --- 4th system: Qwen3-TTS voice-designed voices (steps 21-24) ---
# Same 169 characters and same 8 diversity-utterance texts as the "elevenlabs"
# system - only the voice-generation approach differs, isolating
# that as the variable of interest. voice_mapping.json's `description` is
# distilled by an LLM into a short (~12-25 word) voice-design instruction (see
# generate_qwen_design_instructions.py for why - the endpoint's own example is
# a single short sentence, not a biography).
QWEN_DESIGN_LLM_MODEL="${QWEN_DESIGN_LLM_MODEL:-gpt-4o-mini}"

# --- Number of ElevenLabs characters to process (steps 1, 21, 22) ---
# Empty (default) = all 169 characters in voice_mapping.json. Set to a number
# to restrict to that many characters (same subset picked consistently across
# all 3 character-based steps); set CHARACTER_NAMES instead for exact control
# over which character(s) - see run_pipeline.sh.
CHARACTER_LIMIT="${CHARACTER_LIMIT:-}"
CHARACTER_NAMES="${CHARACTER_NAMES:-}"
